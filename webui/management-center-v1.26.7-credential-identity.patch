@@ -0,0 +1,109 @@
+import { afterEach, describe, expect, test } from 'bun:test';
+import { parse, stringify } from 'yaml';
+import { runVisualConfig } from './helpers/visualConfig';
+import { buildConfigPatch } from '../src/services/api/configPatch';
+import { configFileApi } from '../src/services/api/configFile';
+import { apiClient } from '../src/services/api/client';
+import { providersApi } from '../src/services/api/providers';
+import { normalizeProviderGroups } from '../src/services/api/transformers';
+import type { ProviderKeyConfig } from '../src/types';
+
+const originalGet = apiClient.get,
+  originalPut = apiClient.put;
+afterEach(() => {
+  apiClient.get = originalGet;
+  apiClient.put = originalPut;
+});
+const configured = {
+  catalog: '/synthetic/catalogs/models.json',
+  'codex-catalog': 'https://catalog.invalid/codex.json?revision=1',
+  'devin-catalog': 'http://localhost:19191/devin.json',
+};
+const fixture = (models: Record<string, string>) =>
+  stringify({
+    'config-version': 8,
+    models,
+    server: { port: 8317 },
+    client: { codex: { 'enable-apply-patch': false, 'optimize-multi-agent-v2': true } },
+    upstream: { codex: { 'response-steering': true } },
+    oauth: {
+      providers: {
+        codex: { 'credential-identity': { enabled: true }, 'credential-proxy-policy': 'require' },
+      },
+    },
+    'api-keys': {
+      codex: [
+        {
+          name: 'selected',
+          'base-url': 'https://synthetic.invalid/v1',
+          'proxy-url': 'direct',
+          keys: [{ 'api-key': 'synthetic', 'concurrency-limit': 3 }],
+        },
+      ],
+    },
+    plugins: { configs: { sample: { enabled: false, zero: 0 } } },
+  });
+
+describe('v8.0.15 model catalog configuration compatibility', () => {
+  for (const [name, models] of Object.entries({
+    configured,
+    cleared: { catalog: '', 'codex-catalog': '', 'devin-catalog': '' },
+    empty: {},
+  })) {
+    test(`${name}: visual save preserves catalog sources and only patches edited fields`, () => {
+      const before = fixture(models);
+      const form = runVisualConfig(before, [{ port: '8318' }]);
+      const after = form.applyVisualChangesToYaml(before);
+      expect(parse(after).models).toEqual(models);
+      expect(buildConfigPatch(before, after)).toEqual({
+        patch: { server: { port: 8318 } },
+        deletions: [],
+      });
+      for (const key of ['client', 'upstream', 'oauth', 'api-keys', 'plugins'])
+        expect(parse(after)[key]).toEqual(parse(before)[key]);
+    });
+    test(`${name}: source YAML submits catalog values without client-side filtering`, async () => {
+      const yaml = fixture(models);
+      const calls: unknown[][] = [];
+      apiClient.put = (async (...args: unknown[]) => {
+        calls.push(args);
+      }) as typeof apiClient.put;
+      await configFileApi.saveConfigYaml(yaml);
+      expect(calls).toHaveLength(1);
+      expect(calls[0][0]).toBe('/config.yaml');
+      expect(calls[0][1]).toBe(yaml);
+      expect(calls[0][2]).toMatchObject({ headers: { 'Content-Type': 'application/yaml' } });
+    });
+  }
+  test('unrelated visual edits keep the current server catalog after a concurrent source change', () => {
+    const before = fixture(configured);
+    const latest = fixture({ ...configured, catalog: '/synthetic/catalogs/new.json' });
+    const form = runVisualConfig(before, [{ port: '8318' }]);
+    const after = form.applyVisualChangesToYaml(latest);
+    expect(parse(after).models.catalog).toBe('/synthetic/catalogs/new.json');
+    expect(buildConfigPatch(latest, after)).toEqual({
+      patch: { server: { port: 8318 } },
+      deletions: [],
+    });
+  });
+  test('provider edits stay on their provider endpoint and preserve catalog configuration', async () => {
+    const state = parse(fixture(configured));
+    state['api-keys'].codex[0].keys[0].auth_index = 'selected-index';
+    const row = (normalizeProviderGroups(state['api-keys'].codex) as ProviderKeyConfig[])[0];
+    let writes = 0;
+    apiClient.get = (async () => structuredClone(state)) as typeof apiClient.get;
+    apiClient.put = (async (path: string, value: unknown) => {
+      expect(path).toBe('/config/api-keys/codex');
+      state['api-keys'].codex = value;
+      writes++;
+    }) as typeof apiClient.put;
+    await providersApi.updateCodexConfig(row.apiKey, row.baseUrl, { ...row, priority: 5 });
+    expect(writes).toBe(1);
+    expect(state.models).toEqual(configured);
+    expect(state['api-keys'].codex[0].keys[0]).toMatchObject({
+      'concurrency-limit': 3,
+      priority: 5,
+    });
+    expect(state['api-keys'].codex[0].keys[0].auth_index).toBeUndefined();
+  });
+});
