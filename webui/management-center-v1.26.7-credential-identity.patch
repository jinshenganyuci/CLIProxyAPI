+
+const get = apiClient.get,
+  put = apiClient.put;
+afterEach(() => {
+  apiClient.get = get;
+  apiClient.put = put;
+});
+const fixture = (flag: boolean | undefined) => ({
+  'config-version': 8,
+  server: { port: 8317 },
+  upstream: {
+    claude: {
+      ...(flag === undefined ? {} : { 'tool-search': flag }),
