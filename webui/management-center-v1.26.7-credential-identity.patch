@@ -0,0 +1,258 @@
+import { describe, expect, test } from 'bun:test';
+import { parse as parseYaml } from 'yaml';
+import { runVisualConfig } from './helpers/visualConfig';
+
+const fixture = `config-version: 8
+server:
+  port: 8317
+requests:
+  proxy-url: socks5h://global.invalid:1080
+access:
+  api-keys: [client-one]
+api-keys:
+  codex:
+    - name: private-group
+      base-url: https://upstream.invalid/v1
+      proxy-url: socks5h://credential.invalid:1080
+      keys:
+        - api-key: synthetic-upstream
+          concurrency-limit: 3
+credentials:
+  concurrency:
+    max-limit: 1000000
+oauth:
+  providers:
+    codex:
+      credential-identity:
+        enabled: true
+      credential-proxy-policy: require
+`;
+
+describe('v8 visual YAML boundary', () => {
+  test('loads nested values and client keys without mistaking upstream groups for client keys', () => {
+    const result = runVisualConfig(fixture);
+    expect(result.visualValues.port).toBe('8317');
+    expect(result.visualValues.proxyUrl).toBe('socks5h://global.invalid:1080');
+    expect(result.visualValues.apiKeysText).toBe('client-one');
+  });
+  test('updates the nested proxy and never writes an ignored legacy duplicate', () => {
+    const result = runVisualConfig(fixture, [{ proxyUrl: 'socks5h://changed.invalid:1080' }]);
+    const output = parseYaml(result.applyVisualChangesToYaml(fixture));
+    expect(output.requests['proxy-url']).toBe('socks5h://changed.invalid:1080');
+    expect(output).not.toHaveProperty('proxy-url');
+  });
+  test('editing client keys cannot delete provider groups or credential settings', () => {
+    const result = runVisualConfig(fixture, [{ apiKeysText: 'client-two' }]);
+    const output = parseYaml(result.applyVisualChangesToYaml(fixture));
+    const before = parseYaml(fixture);
+    expect(output.access['api-keys']).toEqual(['client-two']);
+    expect(output['api-keys']).toEqual(before['api-keys']);
+    expect(output.credentials).toEqual(before.credentials);
+    expect(output.oauth).toEqual(before.oauth);
+  });
+  test('clearing client keys leaves upstream groups and credential defaults intact', () => {
+    const result = runVisualConfig(fixture, [{ apiKeysText: '' }]);
+    const output = parseYaml(result.applyVisualChangesToYaml(fixture));
+    expect(output.access).not.toHaveProperty('api-keys');
+    expect(output['api-keys']).toEqual(parseYaml(fixture)['api-keys']);
+    expect(output.credentials).toEqual(parseYaml(fixture).credentials);
+  });
+  test('nested false, zero and empty values win over legacy values by presence', () => {
+    const yaml = `config-version: 8\nport: 9999\nproxy-url: old\nrequest-retry: 3\ndebug: true\nserver: {port: 8317}\nrequests: {proxy-url: ''}\nrouting: {retry: {request-retry: 0}}\nobservability: {logs: {debug: false}}\n`;
+    const result = runVisualConfig(yaml);
+    expect(result.visualValues.port).toBe('8317');
+    expect(result.visualValues.proxyUrl).toBe('');
+    expect(result.visualValues.requestRetry).toBe('0');
+    expect(result.visualValues.debug).toBe(false);
+  });
+
+  test('nested layout without version marker still preserves provider groups', () => {
+    const yaml = fixture.replace('config-version: 8\n', '');
+    const result = runVisualConfig(yaml, [{ apiKeysText: 'two' }]);
+    const output = parseYaml(result.applyVisualChangesToYaml(yaml));
+    expect(output.access['api-keys']).toEqual(['two']);
+    expect(output['api-keys']).toEqual(parseYaml(yaml)['api-keys']);
+  });
+  test('unknown nested fields, comments and anchors survive an unrelated edit', () => {
+    const yaml =
+      fixture +
+      '\n# Keep plugin note\nplugins:\n  configs:\n    access-guard: &guard\n      weekly_usd_limit: 0\n      labels: [one, two]\n    mirror: *guard\n';
+    const result = runVisualConfig(yaml, [{ port: '8318' }]);
+    const text = result.applyVisualChangesToYaml(yaml);
+    const output = parseYaml(text);
+    expect(output.server.port).toBe(8318);
+    expect(output.plugins).toEqual(parseYaml(yaml).plugins);
+    expect(text).toContain('# Keep plugin note');
+    expect(text).toContain('&guard');
+    expect(text).toContain('*guard');
+  });
+  test('no-op visual save retains provider inheritance and unknown options', () => {
+    const yaml = fixture.replace(
+      'concurrency-limit: 3',
+      'concurrency-limit: null\n          unknown-option: false'
+    );
+    const result = runVisualConfig(yaml);
+    expect(parseYaml(result.applyVisualChangesToYaml(yaml))).toEqual(parseYaml(yaml));
+  });
+  test('stale visual values preserve the latest unrelated v8 settings', () => {
+    const result = runVisualConfig(fixture, [{ proxyUrl: 'http://edited.invalid:8080' }]);
+    const latest = fixture
+      .replace('port: 8317', 'port: 8319')
+      .replace('concurrency-limit: 3', 'concurrency-limit: 7');
+    const output = parseYaml(result.applyVisualChangesToYaml(latest));
+    expect(output.server.port).toBe(8319);
+    expect(output['api-keys'].codex[0].keys[0]['concurrency-limit']).toBe(7);
+    expect(output.requests['proxy-url']).toBe('http://edited.invalid:8080');
+  });
+  test('legacy form remains usable when another editor migrates the current YAML', () => {
+    const result = runVisualConfig('port: 8317\nproxy-url: old\napi-keys: [client-one]\n', [
+      { proxyUrl: 'http://edited.invalid:8080' },
+    ]);
+    const output = parseYaml(result.applyVisualChangesToYaml(fixture));
+    expect(output.requests['proxy-url']).toBe('http://edited.invalid:8080');
+    expect(output['api-keys']).toEqual(parseYaml(fixture)['api-keys']);
+    expect(output).not.toHaveProperty('proxy-url');
+  });
+  test('streaming edits write all three nested request controls', () => {
+    const result = runVisualConfig(fixture, [
+      {
+        streaming: {
+          keepaliveSeconds: '5',
+          bootstrapRetries: '2',
+          nonstreamKeepaliveInterval: '7',
+        },
+      },
+    ]);
+    const output = parseYaml(result.applyVisualChangesToYaml(fixture));
+    expect(output.requests.streaming).toEqual({ 'keepalive-seconds': 5, 'bootstrap-retries': 2 });
+    expect(output.requests['nonstream-keepalive-interval']).toBe(7);
+    expect(output).not.toHaveProperty('streaming');
+  });
+  test('nested payload rules retain comments and unknown parameters through an edit', () => {
+    const yaml = fixture.replace(
+      '  proxy-url: socks5h://global.invalid:1080',
+      `  proxy-url: socks5h://global.invalid:1080
+  payload:
+    override:
+      # Keep payload comment
+      - models: [{name: fixture, future-model: yes}]
+        params: {temperature: 1}
+        future-rule: retained`
+    );
+    const loaded = runVisualConfig(yaml).visualValues.payloadOverrideRules;
+    const rules = loaded.map((rule) => ({
+      ...rule,
+      params: rule.params.map((param) => ({ ...param, value: '2' })),
+    }));
+    const result = runVisualConfig(yaml, [{ payloadOverrideRules: rules }]);
+    const text = result.applyVisualChangesToYaml(yaml);
+    const rule = parseYaml(text).requests.payload.override[0];
+    expect(rule.params.temperature).toBe(2);
+    expect(rule['future-rule']).toBe('retained');
+    expect(rule.models[0]['future-model']).toBe('yes');
+    expect(text).toContain('# Keep payload comment');
+    expect(parseYaml(text)).not.toHaveProperty('payload');
+  });
+  const cases = [
+    ['host', '127.0.0.2', ['server', 'host'], '127.0.0.2'],
+    ['tlsEnable', true, ['server', 'tls', 'enable'], true],
+    ['rmAllowRemote', true, ['management', 'allow-remote'], true],
+    ['rmSecretKey', 'synthetic-secret', ['management', 'secret-key'], 'synthetic-secret'],
+    ['rmDisableControlPanel', true, ['management', 'disable-control-panel'], true],
+    ['rmDisableAutoUpdatePanel', true, ['management', 'disable-auto-update-panel'], true],
+    [
+      'rmPanelRepo',
+      'https://example.invalid/ui',
+      ['management', 'panel-github-repository'],
+      'https://example.invalid/ui',
+    ],
+    ['authDir', '/synthetic/auths', ['oauth', 'auth-dir'], '/synthetic/auths'],
+    ['commercialMode', true, ['server', 'commercial-mode'], true],
+    ['debug', true, ['observability', 'logs', 'debug'], true],
+    ['loggingToFile', true, ['observability', 'logs', 'logging-to-file'], true],
+    ['logsMaxTotalSizeMb', '20', ['observability', 'logs', 'logs-max-total-size-mb'], 20],
+    ['errorLogsMaxFiles', '3', ['observability', 'logs', 'error-logs-max-files'], 3],
+    ['usageStatisticsEnabled', true, ['observability', 'usage', 'usage-statistics-enabled'], true],
+    [
+      'redisUsageQueueRetentionSeconds',
+      '40',
+      ['observability', 'usage', 'redis-usage-queue-retention-seconds'],
+      40,
+    ],
+    ['forceModelPrefix', true, ['routing', 'force-model-prefix'], true],
+    ['passthroughHeaders', true, ['requests', 'passthrough-headers'], true],
+    ['requestRetry', '2', ['routing', 'retry', 'request-retry'], 2],
+    ['maxRetryCredentials', '3', ['routing', 'retry', 'max-retry-credentials'], 3],
+    ['maxRetryInterval', '4', ['routing', 'retry', 'max-retry-interval'], 4],
+    ['disableCooling', true, ['routing', 'cooldown', 'disable-cooling'], true],
+    ['disableImageGeneration', 'chat', ['multimedia', 'disable-image-generation'], 'chat'],
+    [
+      'gptImage2BaseModel',
+      'synthetic-image',
+      ['multimedia', 'gpt-image-2-base-model'],
+      'synthetic-image',
+    ],
+    ['authAutoRefreshWorkers', '5', ['oauth', 'auth-auto-refresh-workers'], 5],
+    ['wsAuth', false, ['oauth', 'providers', 'aistudio', 'ws-auth'], false],
+    [
+      'antigravitySensitiveWords',
+      ['hello'],
+      ['oauth', 'providers', 'antigravity', 'sensitive-words'],
+      ['hello'],
+    ],
+    [
+      'devinSensitiveWords',
+      ['hello'],
+      ['oauth', 'providers', 'devin', 'sensitive-words'],
+      ['hello'],
+    ],
+    [
+      'antigravitySignatureCacheEnabled',
+      false,
+      ['oauth', 'providers', 'antigravity', 'signature-cache-enabled'],
+      false,
+    ],
+    [
+      'antigravitySignatureBypassStrict',
+      true,
+      ['oauth', 'providers', 'antigravity', 'signature-bypass-strict'],
+      true,
+    ],
+    [
+      'claudeHeaderUserAgent',
+      'synthetic-agent',
+      ['upstream', 'claude', 'header-defaults', 'user-agent'],
+      'synthetic-agent',
+    ],
+    [
+      'codexHeaderBetaFeatures',
+      'synthetic-beta',
+      ['oauth', 'providers', 'codex', 'header-defaults', 'beta-features'],
+      'synthetic-beta',
+    ],
+    [
+      'quotaAntigravityCredits',
+      true,
+      ['oauth', 'providers', 'antigravity', 'antigravity-credits'],
+      true,
+    ],
+    ['routingSessionAffinity', true, ['routing', 'session-affinity'], true],
+    ['pluginsEnabled', true, ['plugins', 'enabled'], true],
+  ] as const;
+  for (const [field, value, path, stored] of cases) {
+    test(`visual ${field} writes its effective v8 path and reads it back`, () => {
+      const result = runVisualConfig(fixture, [{ [field]: value }]);
+      const output = result.applyVisualChangesToYaml(fixture);
+      expect(path.reduce((value, key) => value?.[key], parseYaml(output))).toEqual(stored);
+      expect(runVisualConfig(output).visualValues[field]).toEqual(value);
+      expect(parseYaml(output)['api-keys']).toEqual(parseYaml(fixture)['api-keys']);
+    });
+  }
+});
+
