@@ -0,0 +1,74 @@
+import { afterEach, describe, expect, mock, spyOn, test } from 'bun:test';
+import { apiClient } from '@/services/api/client';
+import { oauthApi } from '@/services/api/oauth';
+
+const started = { url: 'https://auth.example.invalid/authorize', state: 'synthetic-state' };
+
+afterEach(() => mock.restore());
+
+for (const provider of ['codex', 'devin', 'meta', 'kimi', 'kimi-ai']) {
+  describe(`${provider} login proxy requests`, () => {
+    test('sends proxy credentials only in the POST body and preserves cancellation', async () => {
+      const post = spyOn(apiClient, 'post').mockResolvedValue(started);
+      const get = spyOn(apiClient, 'get').mockResolvedValue(started);
+      const proxyURL = 'http://test-user:test-password@proxy.example.invalid:8080';
+      const signal = new AbortController().signal;
+
+      await oauthApi.startAuth(provider, signal, { proxyURL: ` ${proxyURL} ` });
+
+      expect(post).toHaveBeenCalledWith(
+        '/oauth/auth-url',
+        {
+          is_webui: true,
+          proxy_url: proxyURL,
+        },
+        { params: { provider }, signal }
+      );
+      expect(get).not.toHaveBeenCalled();
+    });
+
+    test('distinguishes global settings from explicit direct access', async () => {
+      const post = spyOn(apiClient, 'post').mockResolvedValue(started);
+
+      await oauthApi.startAuth(provider);
+      await oauthApi.startAuth(provider, undefined, { proxyURL: 'direct' });
+
+      expect(post.mock.calls).toEqual([
+        ['/oauth/auth-url', { is_webui: true }, { params: { provider } }],
+        ['/oauth/auth-url', { is_webui: true, proxy_url: 'direct' }, { params: { provider } }],
+      ]);
+    });
+  });
+}
+
+test('retains a Codex reauthentication target without putting it in the URL', async () => {
+  const post = spyOn(apiClient, 'post').mockResolvedValue(started);
+
+  await oauthApi.startAuth('codex', undefined, {
+    authIndex: 'synthetic-index',
+    proxyURL: 'direct',
+  });
+
+  expect(post).toHaveBeenCalledWith(
+    '/oauth/auth-url',
+    {
+      is_webui: true,
+      proxy_url: 'direct',
+      auth_index: 'synthetic-index',
+    },
+    { params: { provider: 'codex' } }
+  );
+});
+
+test('leaves other provider login requests unchanged', async () => {
+  const get = spyOn(apiClient, 'get').mockResolvedValue(started);
+  const post = spyOn(apiClient, 'post').mockResolvedValue(started);
+  const signal = new AbortController().signal;
+
+  await oauthApi.startAuth('anthropic', signal, { proxyURL: 'direct' });
+
+  expect(get.mock.calls).toEqual([
+    ['/oauth/auth-url', { params: { provider: 'claude', is_webui: true }, signal }],
+  ]);
+  expect(post).not.toHaveBeenCalled();
+});
diff --git a/tests/providerConcurrencyPreservation.test.ts b/tests/providerConcurrencyPreservation.test.ts
new file mode 100644
index 0000000..6c01c69
--- /dev/null
+++ b/tests/providerConcurrencyPreservation.test.ts
@@ -0,0 +1,279 @@
+import { afterEach, describe, expect, test } from 'bun:test';
+import { apiClient } from '../src/services/api/client';
+import { providersApi } from '../src/services/api/providers';
+import {
+  normalizeApiKeyEntry,
+  normalizeProviderKeyConfig,
+  normalizeProviderGroups,
+} from '../src/services/api/transformers';
+import {
+  buildOpenAIConfig,
+  buildProviderKeyConfig,
+} from '../src/features/providers/useProviderWorkbench';
+import type { ProviderEntryFormInput } from '../src/features/providers/types';
+import type { OpenAIProviderConfig } from '../src/types/provider';
+
+type SavedGroup = Record<string, unknown> & { keys: Record<string, unknown>[] };
+
+const originalGet = apiClient.get;
+const originalPut = apiClient.put;
+afterEach(() => {
+  apiClient.get = originalGet;
+  apiClient.put = originalPut;
+});
+
+const form = (patch: Partial<ProviderEntryFormInput> = {}): ProviderEntryFormInput => ({
+  apiKey: '',
+  name: 'example',
+  baseUrl: 'https://new.example/v1',
+  proxyUrl: 'socks5://new.example:1080',
+  prefix: '',
+  disabled: false,
+  models: [{ name: 'new-model', alias: 'new-alias' }],
+  headers: [],
+  excludedModelsText: '',
+  ...patch,
+});
+
+const captureWrites = (raw: Record<string, unknown>) => {
+  const writes: Array<{ path: string; value: unknown }> = [];
+  apiClient.get = (async () => raw) as typeof apiClient.get;
+  apiClient.put = (async (path: string, value?: unknown) => {
+    writes.push({ path, value });
+    return undefined;
+  }) as typeof apiClient.put;
+  return writes;
+};
+
+const brands = [
+  ['gemini', 'gemini-api-key', providersApi.createGeminiKey, providersApi.updateGeminiKey],
+  [
+    'interactions',
+    'interactions-api-key',
+    providersApi.createInteractionsKey,
+    providersApi.updateInteractionsKey,
+  ],
+  ['codex', 'codex-api-key', providersApi.createCodexConfig, providersApi.updateCodexConfig],
+  ['meta', 'meta-api-key', providersApi.createMetaConfig, providersApi.updateMetaConfig],
+  ['xai', 'xai-api-key', providersApi.createXAIConfig, providersApi.updateXAIConfig],
+  ['claude', 'claude-api-key', providersApi.createClaudeConfig, providersApi.updateClaudeConfig],
+  ['vertex', 'vertex-api-key', providersApi.createVertexConfig, providersApi.updateVertexConfig],
+] as const;
+
+describe('v8 direct provider concurrency preservation', () => {
+  for (const [brand, , create, update] of brands) {
+    const group = (limit?: number) => ({
+      name: 'shared',
+      'base-url': 'https://old.example/v1',
+      keys: [
+        {
+          'api-key': 'same-key',
+          'proxy-url': 'socks5://first.example:1080',
+          'concurrency-limit': 2,
+          'future-field': 'first',
+        },
+        {
+          'api-key': 'same-key',
+          'proxy-url': 'socks5://second.example:1080',
+          ...(limit === undefined ? {} : { 'concurrency-limit': limit }),
+          'future-field': 'second',
+        },
+      ],
+    });
+    test(`${brand}: stale edits refuse changed limits; refreshed edits keep latest limits and sibling routes`, async () => {
+      const existing = normalizeProviderGroups([group(3)])[1]!;
+      expect(existing.concurrencyLimit).toBe(3);
+      const latest = group(7);
+      const writes = captureWrites({ 'api-keys': { [brand]: [latest] } });
+      await expect(
+        update(existing.apiKey, existing.baseUrl, buildProviderKeyConfig(brand, form(), existing))
+      ).rejects.toThrow('configuration changed');
+      expect(writes).toEqual([]);
+      const fresh = normalizeProviderGroups([structuredClone(latest)])[1]!;
+      await update(fresh.apiKey, fresh.baseUrl, buildProviderKeyConfig(brand, form(), fresh));
+      expect(writes[0]?.path).toBe(`/config/api-keys/${brand}`);
+      const saved = (writes[0].value as SavedGroup[])[0];
+      expect(saved.keys[0]).toEqual(latest.keys[0]);
+      expect(saved.keys[1]['concurrency-limit']).toBe(7);
+      expect(saved.keys[1]['proxy-url']).toBe('socks5://new.example:1080');
+      expect(saved.keys[1]['future-field']).toBe('second');
+      expect(saved.keys[1].models).toEqual([{ name: 'new-model', alias: 'new-alias' }]);
+      expect(saved['base-url']).toBe('https://new.example/v1');
+      expect(JSON.stringify(saved)).not.toContain('sourceIdentity');
+    });
+    test(`${brand}: stale form cannot undo a reset to the default`, async () => {
+      const existing = normalizeProviderGroups([group(3)])[1]!;
+      const latest = group();
+      const writes = captureWrites({ 'api-keys': { [brand]: [latest] } });
+      await expect(
+        update(existing.apiKey, existing.baseUrl, buildProviderKeyConfig(brand, form(), existing))
+      ).rejects.toThrow('configuration changed');
+      expect(writes).toEqual([]);
+      const fresh = normalizeProviderGroups([structuredClone(latest)])[1]!;
+      await update(fresh.apiKey, fresh.baseUrl, buildProviderKeyConfig(brand, form(), fresh));
+      expect((writes[0].value as SavedGroup[])[0].keys[1]).not.toHaveProperty('concurrency-limit');
+    });
+    test(`${brand}: creation serializes a configured limit and leaves omitted default absent`, async () => {
+      const writes = captureWrites({ 'api-keys': { [brand]: [] } });
+      await create({ apiKey: 'configured-key', concurrencyLimit: 3 });
+      await create({ apiKey: 'default-key' });
+      expect((writes[0].value as SavedGroup[])[0].keys[0]['concurrency-limit']).toBe(3);
+      expect((writes[1].value as SavedGroup[])[0].keys[0]).not.toHaveProperty('concurrency-limit');
+    });
+  }
+  test('ambiguous credentials without a persisted group identity fail before PUT', async () => {
+    const item = { 'api-key': 'same-key' };
+    const writes = captureWrites({
+      'api-keys': { codex: [{ name: 'group', keys: [item, item] }] },
+    });
+    const existing = normalizeProviderKeyConfig(item)!;
+    await expect(
+      providersApi.updateCodexConfig(
+        existing.apiKey,
+        existing.baseUrl,
+        buildProviderKeyConfig('codex', form(), existing)
+      )
+    ).rejects.toThrow('configuration changed');
+    expect(writes).toEqual([]);
+  });
+});
+
+const compatibleRaw = () => ({
+  name: 'example',
+  'base-url': 'https://old.example/v1',
+  'concurrency-limit': 4,
+  'future-provider': 'preserved',
+  keys: [
+    {
+      'api-key': 'same-key',
+      'proxy-url': 'socks5://first.example:1080',
+      'concurrency-limit': 3,
+      'future-entry': 'first',
+    },
+    {
+      'api-key': 'same-key',
+      'proxy-url': 'socks5://second.example:1080',
+      'concurrency-limit': 7,
+      'future-entry': 'second',
+    },
+  ],
+});
+const normalizedOpenAI = (raw: Record<string, unknown>) =>
+  normalizeProviderGroups([structuredClone(raw)], true)[0] as OpenAIProviderConfig;
+const entryInput = (provider: OpenAIProviderConfig, index: number) => {
+  const entry = provider.apiKeyEntries[index];
+  return {
+    apiKey: '',
+    existingApiKey: entry.apiKey,
+    proxyUrl: entry.proxyUrl ?? '',
+    sourceIndex: entry.sourceIndex,
+    concurrencyLimit: entry.concurrencyLimit,
+  };
+};
+
+describe('v8 OpenAI-compatible concurrency and stable row identity', () => {
+  test('normalizes per-key limits and the independent group fallback', () => {
+    const existing = normalizedOpenAI(compatibleRaw());
+    expect(existing.concurrencyLimit).toBe(4);
+    expect(existing.apiKeyEntries.map((e) => e.concurrencyLimit)).toEqual([3, 7]);
+    expect(normalizeApiKeyEntry({ 'api-key': 'default' })?.concurrencyLimit).toBeUndefined();
+  });
+  test('changed limits reject stale edits; refreshed duplicate rows retain correct limits on reorder', async () => {
+    const raw = compatibleRaw(),
+      old = normalizedOpenAI(raw);
+    raw.keys[1]['concurrency-limit'] = 8;
+    raw['concurrency-limit'] = 9;
+    const writes = captureWrites({ 'api-keys': { 'openai-compatibility': [raw] } });
+    await expect(
+      providersApi.updateOpenAIProvider(
+        old.name,
+        0,
+        buildOpenAIConfig(form({ apiKeyEntries: [entryInput(old, 1), entryInput(old, 0)] }), old)
+      )
+    ).rejects.toThrow('configuration changed');
+    expect(writes).toEqual([]);
+    const existing = normalizedOpenAI(raw);
+    const next = buildOpenAIConfig(
+      form({
+        apiKeyEntries: [
+          { ...entryInput(existing, 1), proxyUrl: 'socks5://changed.example:1080' },
+          entryInput(existing, 0),
+        ],
+      }),
+      existing
+    );
+    await providersApi.updateOpenAIProvider(existing.name, 0, next);
+    const saved = (writes[0].value as SavedGroup[])[0];
+    expect(saved['concurrency-limit']).toBe(9);
+    expect(saved.keys).toEqual([
+      { ...raw.keys[1], 'proxy-url': 'socks5://changed.example:1080' },
+      raw.keys[0],
+    ]);
+    expect(saved['future-provider']).toBe('preserved');
+    expect(JSON.stringify(saved)).not.toContain('sourceIndex');
+  });
+  test('deleting a duplicate and adding a new entry never transfers its limit', async () => {
+    const raw = compatibleRaw(),
+      existing = normalizedOpenAI(raw);
+    const writes = captureWrites({ 'api-keys': { 'openai-compatibility': [raw] } });
+    const next = buildOpenAIConfig(
+      form({ apiKeyEntries: [entryInput(existing, 1), { apiKey: 'new-key', proxyUrl: '' }] }),
+      existing
+    );
+    await providersApi.updateOpenAIProvider(existing.name, 0, next);
+    expect((writes[0].value as SavedGroup[])[0].keys).toEqual([
+      raw.keys[1],
+      { 'api-key': 'new-key' },
+    ]);
+  });
+  test('a removed entry cannot be recreated from a stale snapshot', async () => {
+    const raw = compatibleRaw(),
+      existing = normalizedOpenAI(raw);
+    const writes = captureWrites({
+      'api-keys': { 'openai-compatibility': [{ ...raw, keys: [raw.keys[0]] }] },
+    });
+    await expect(
+      providersApi.updateOpenAIProvider(
+        existing.name,
+        0,
+        buildOpenAIConfig(form({ apiKeyEntries: [entryInput(existing, 1)] }), existing)
+      )
+    ).rejects.toThrow('configuration changed');
+    expect(writes).toEqual([]);
+  });
+  for (const limit of [5, undefined])
+    test(`fallback retains current ${limit ?? 'default'} while editing URL`, async () => {
+      const raw = {
+        name: 'fallback',
+        'base-url': 'https://old.example/v1',
+        keys: [],
+        ...(limit === undefined ? {} : { 'concurrency-limit': limit }),
+      };
+      const existing = normalizedOpenAI(raw),
+        writes = captureWrites({ 'api-keys': { 'openai-compatibility': [raw] } });
+      await providersApi.updateOpenAIProvider(
+        existing.name,
+        0,
+        buildOpenAIConfig(form({ name: 'fallback', apiKeyEntries: [] }), existing)
+      );
+      const saved = (writes[0].value as SavedGroup[])[0];
+      expect(saved['concurrency-limit']).toBe(limit);
+      expect(saved.keys).toEqual([]);
+      expect(saved['base-url']).toBe('https://new.example/v1');
+    });
+  test('creation serializes independent group and key limits without inventing a default', async () => {
+    const writes = captureWrites({ 'api-keys': { 'openai-compatibility': [] } });
+    await providersApi.createOpenAIProvider({
+      name: 'new',
+      baseUrl: 'https://new.example/v1',
+      concurrencyLimit: 4,
+      apiKeyEntries: [{ apiKey: 'configured', concurrencyLimit: 3 }, { apiKey: 'default' }],
+    });
+    const saved = (writes[0].value as SavedGroup[])[0];
+    expect(saved['concurrency-limit']).toBe(4);
+    expect(saved.keys).toEqual([
+      { 'api-key': 'configured', 'concurrency-limit': 3 },
+      { 'api-key': 'default' },
+    ]);
+  });
+});
