+import { describe, expect, test } from 'bun:test';
+import { readFileSync } from 'node:fs';
+import { parse, stringify } from 'yaml';
+import { runVisualConfig } from './helpers/visualConfig';
+
+describe('v8.0.27 configuration survives unrelated visual edits', () => {
+  for (const enabled of [true, false]) {
+    test(`preserves native request and routing policies, including explicit ${enabled}`, () => {
+      const source = readFileSync('tests/v8VisualConfig.test.ts', 'utf8');
+      const original = parse(source.match(/const fixture = `([\s\S]*?)`;/)![1]);
+      original.server['max-request-body-bytes'] = enabled ? 123456 : 0;
+      original.routing = { ...original.routing, 'session-affinity-rebind-on': enabled ? 'quota' : 'any' };
+      original.requests = { ...original.requests, streaming: { ...original.requests?.streaming, 'send-keepalive-before-ft': enabled } };
+      original.oauth.providers.codex['signin-with-chatgpt-identifier'] = 'Synthetic Custom Agent';
+      const input = stringify(original);
+      const updated = parse(runVisualConfig(input, [{ port: '8327' }]).applyVisualChangesToYaml(input));
+      expect(updated.server.port).toBe(8327);
+      expect(updated.server['max-request-body-bytes']).toBe(enabled ? 123456 : 0);
+      expect(updated.routing['session-affinity-rebind-on']).toBe(enabled ? 'quota' : 'any');
+      expect(updated.requests.streaming['send-keepalive-before-ft']).toBe(enabled);
+      expect(updated.oauth.providers.codex['signin-with-chatgpt-identifier']).toBe('Synthetic Custom Agent');
+      expect(updated['api-keys']).toEqual(original['api-keys']);
+      expect(updated.plugins).toEqual(original.plugins);
+    });
+  }
+});
