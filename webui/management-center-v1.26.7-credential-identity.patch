diff --git a/tests/forkV1251Policies.test.ts b/tests/forkV1251Policies.test.ts
new file mode 100644
index 0000000..b23fa3d
--- /dev/null
+++ b/tests/forkV1251Policies.test.ts
@@ -0,0 +1,140 @@
+import { afterEach, describe, expect, test } from 'bun:test';
+import { apiClient } from '@/services/api/client';
+import { providersApi } from '@/services/api/providers';
+import { normalizeProviderGroups } from '@/services/api/transformers';
+import { buildRuntimePolicy, readRuntimePolicy } from '@/features/providers/runtimePolicy';
+import { readCredentialPolicy } from '@/features/authFiles/credentialPolicy';
+import {
+  buildAuthFileFieldsPatch,
+  type PrefixProxyEditorState,
+} from '@/features/authFiles/hooks/useAuthFilesPrefixProxyEditor';
+
+const originalGet = apiClient.get;
+const originalPut = apiClient.put;
+afterEach(() => {
+  apiClient.get = originalGet;
+  apiClient.put = originalPut;
+});
+
+const editor = (): PrefixProxyEditorState => {
+  const json = {
+    type: 'codex',
+    access_token: 'synthetic-token',
+    proxy_url: 'direct',
+    concurrency_limit: 3,
+    codex_namespace: 'synthetic-identity',
+    request_retry: 4,
+    model_aliases: [{ name: 'native-model', alias: 'public-model', 'force-mapping': false }],
+  };
+  return {
+    fileName: 'synthetic.json',
+    authIndex: 'synthetic-index',
+    fileInfoText: '',
+    loading: false,
+    saving: false,
+    error: null,
+    originalText: JSON.stringify(json),
+    rawText: JSON.stringify(json),
+    invalidContentPreview: '',
+    json,
+    providerKey: 'codex',
+    prefix: '',
+    proxyUrl: 'direct',
+    priority: '',
+    weight: '',
+    weightError: null,
+    concurrencyLimit: '2',
+    concurrencyTouched: true,
+    concurrencyError: null,
+    disableCooling: false,
+    disableCoolingTouched: false,
+    websockets: false,
+    websocketsTouched: false,
+    usingApi: false,
+    usingApiTouched: false,
+    note: '',
+    noteTouched: false,
+    excludedModelsText: '',
+    excludedModelsTouched: false,
+    headersText: '',
+    headersTouched: false,
+    headersError: null,
+    policy: {
+      ...readCredentialPolicy(json),
+      requestRetry: { mode: 'custom', value: '0' },
+      touched: { requestRetry: true },
+    },
+  };
+};
+
+describe('native credential policies coexist with fork admission and egress', () => {
+  test('one narrow credential patch updates retry and concurrency without resending secrets or identity', () => {
+    const draft = editor();
+    const before = structuredClone(draft.json);
+    expect(buildAuthFileFieldsPatch(draft, (key) => key)).toEqual({
+      concurrency_limit: 2,
+      request_retry: 0,
+    });
+    expect(draft.json).toEqual(before);
+  });
+  test('configuration-backed concurrency-only edits ignore unrelated policy drafts', () => {
+    const draft = { ...editor(), concurrencyOnly: true, concurrencyLimit: '' };
+    expect(buildAuthFileFieldsPatch(draft, (key) => key)).toEqual({ concurrency_limit: null });
+  });
+  test('Home-managed concurrency remains unchanged while independent policy edits are retained', () => {
+    const draft = { ...editor(), concurrencyManaged: true };
+    expect(buildAuthFileFieldsPatch(draft, (key) => key)).toEqual({ request_retry: 0 });
+  });
+  test.each(['3', ''])('invalid touched policy blocks a combined concurrency %s write', (limit) => {
+    const draft = editor();
+    draft.concurrencyLimit = limit;
+    draft.policy!.requestRetry.value = '-1';
+    expect(() => buildAuthFileFieldsPatch(draft, (key) => key)).toThrow(
+      'auth_files.policy_retry_invalid'
+    );
+  });
+  test('provider policy override and reset retain key limits, proxy, model flags, siblings and unknown metadata', async () => {
+    let stored = {
+      name: 'synthetic-group',
+      'request-retry': 5,
+      'disable-cooling': true,
+      'concurrency-limit': 7,
+      keys: [
+        {
+          'api-key': 'key-a',
+          'proxy-url': 'socks5h://user:synthetic@proxy.invalid:1080',
+          'concurrency-limit': 3,
+          models: [{ name: 'model', 'support-configuration-update': true }],
+          'opaque-field': { enabled: false },
+        },
+        { 'api-key': 'key-b', 'proxy-url': 'direct' },
+      ],
+    };
+    const baseline = structuredClone(stored);
+    apiClient.get = (async () => ({
+      'api-keys': { codex: [structuredClone(stored)] },
+    })) as typeof apiClient.get;
+    apiClient.put = (async (path: string, groups: (typeof stored)[]) => {
+      expect(path).toBe('/config/api-keys/codex');
+      stored = structuredClone(groups[0]);
+    }) as typeof apiClient.put;
+    let selected = normalizeProviderGroups([stored])[0]!;
+    await providersApi.updateCodexConfig(selected.apiKey, selected.baseUrl, {
+      ...selected,
+      ...buildRuntimePolicy({ ...readRuntimePolicy(selected), cooling: 'enabled', retry: '0' }),
+    });
+    expect(stored.keys[0]).toEqual({
+      ...baseline.keys[0],
+      'disable-cooling': false,
+      'request-retry': 0,
+    });
+    expect(stored.keys[1]).toEqual(baseline.keys[1]);
+    expect(stored['concurrency-limit']).toBe(7);
+    selected = normalizeProviderGroups([stored])[0]!;
+    await providersApi.updateCodexConfig(selected.apiKey, selected.baseUrl, {
+      ...selected,
+      ...buildRuntimePolicy({ ...readRuntimePolicy(selected), cooling: 'inherit', retry: '' }),
+    });
+    expect(stored).toEqual(baseline);
+  });
+});
diff --git a/tests/forkV1252ClaudeReset.test.ts b/tests/forkV1252ClaudeReset.test.ts
new file mode 100644
index 0000000..1ffe586
--- /dev/null
+++ b/tests/forkV1252ClaudeReset.test.ts
@@ -0,0 +1,102 @@
+import { afterEach, describe, expect, test } from 'bun:test';
+import { apiClient } from '@/services/api/client';
+import {
+  claimClaudeResetGrant,
+  readClaudeOrganization,
+  readClaudeResetGrants,
+} from '@/services/api/claudeResetGrants';
+import { createResetGrantOperations } from '@/features/quota/providers/claude/resetGrantOperations';
+import type { ApiCallRequest } from '@/services/api/apiCall';
+
+const originalPost = apiClient.post;
+afterEach(() => {
+  apiClient.post = originalPost;
+});
+const organization = '11111111-2222-4333-8444-555555555555';
+const grant = 'synthetic-reset';
+const status = {
+  eligible: true,
+  at_limit: true,
+  grants: [{ id: grant, resets_total: 2, resets_left: 1, usable_now: true }],
+};
+
+describe('Claude reset selected credential management boundary', () => {
+  for (const selected of ['credential-proxy-a', 'credential-direct-b', 'credential-proxy-c']) {
+    test(`${selected}: usage, profile and claim retain selected auth and token substitution`, async () => {
+      const calls: { path: string; request: ApiCallRequest }[] = [];
+      apiClient.post = (async (path: string, request: ApiCallRequest) => {
+        calls.push({ path, request: structuredClone(request) });
+        return {
+          status_code: 200,
+          body: JSON.stringify(
+            request.method === 'POST'
+              ? { result: 'reset' }
+              : request.url.endsWith('/profile')
+                ? { organization: { uuid: organization } }
+                : { cedar_ember: status }
+          ),
+        };
+      }) as typeof apiClient.post;
+      expect((await readClaudeResetGrants(selected)).grants[0].resetsLeft).toBe(1);
+      expect(await readClaudeOrganization(selected)).toBe(organization);
+      expect(await claimClaudeResetGrant(selected, organization, grant, 'request-fixture')).toBe(
+        'reset'
+      );
+      expect(calls).toHaveLength(3);
+      for (const { path, request } of calls) {
+        expect(path).toBe('/requests/api-call');
+        expect(request.authIndex).toBe(selected);
+        expect(request).not.toHaveProperty('proxy_url');
+        expect(request.header?.Authorization).toBe('Bearer $TOKEN$');
+        expect(request.url.startsWith('https://api.anthropic.com/')).toBe(true);
+      }
+      expect(JSON.parse(calls[2].request.data!)).toEqual({
+        program: 'cedar_ember',
+        grant_id: grant,
+        request_id: 'request-fixture',
+      });
+    });
+  }
+
+  test('failed selected credential read never retries without its auth index', async () => {
+    const calls: ApiCallRequest[] = [];
+    apiClient.post = (async (_path: string, request: ApiCallRequest) => {
+      calls.push(request);
+      throw new Error('selected credential unavailable');
+    }) as typeof apiClient.post;
+    await expect(readClaudeResetGrants('credential-proxy-a')).rejects.toThrow();
+    expect(calls).toHaveLength(1);
+    expect(calls[0].authIndex).toBe('credential-proxy-a');
+    expect(calls[0]).not.toHaveProperty('proxy_url');
+  });
+
+  test('connection replacement during eligibility read prevents claim dispatch', async () => {
+    let revision = 1;
+    let claims = 0;
+    const operations = createResetGrantOperations({
+      revision: () => revision,
+      now: () => 0,
+      requestId: () => 'request-fixture',
+      readOrganization: async () => organization,
+      readStatus: async () => {
+        revision++;
+        return {
+          eligible: true,
+          ineligibleReason: null,
+          atLimit: true,
+          grants: [],
+          nextGrantId: null,
+          weeklyResetsAt: null,
+          cooldownUntil: null,
+        };
+      },
+      claim: async () => {
+        claims++;
+        return 'reset';
+      },
+    });
+    await expect(operations.run('credential-a', 'auth-a', grant)).rejects.toThrow('session');
+    expect(claims).toBe(0);
+    expect(operations.inspect('credential-a')).toBeUndefined();
+  });
+});
diff --git a/tests/forkV125Contracts.test.ts b/tests/forkV125Contracts.test.ts
new file mode 100644
index 0000000..f0d3b9f
--- /dev/null
+++ b/tests/forkV125Contracts.test.ts
@@ -0,0 +1,72 @@
+import { afterEach, describe, expect, spyOn, test } from 'bun:test';
+import { apiClient } from '@/services/api/client';
+import { codexCredentialIdentityApi } from '@/services/api/codexCredentialIdentity';
+import { logsApi } from '@/services/api/logs';
+import { parseLogLine } from '@/features/logs/model/logParsing';
+
+const restorers: (() => void)[] = [];
+afterEach(() => {
+  for (const restore of restorers.splice(0)) restore();
+});
+
+describe('fork operations on the v8 management API', () => {
+  test('identity status, settings, initialization and rotation use authenticated v8 operations', async () => {
+    const get = spyOn(apiClient, 'get').mockResolvedValue({});
+    const put = spyOn(apiClient, 'put').mockResolvedValue({});
+    const post = spyOn(apiClient, 'post').mockResolvedValue({});
+    restorers.push(
+      () => get.mockRestore(),
+      () => put.mockRestore(),
+      () => post.mockRestore()
+    );
+    await codexCredentialIdentityApi.getStatus();
+    await codexCredentialIdentityApi.update({ credential_proxy_policy: 'require' });
+    await codexCredentialIdentityApi.initialize();
+    await codexCredentialIdentityApi.rotate('synthetic.json', 'synthetic-index');
+    expect(get).toHaveBeenCalledWith('/credentials/codex-identity');
+    expect(put).toHaveBeenCalledWith('/credentials/codex-identity', {
+      credential_proxy_policy: 'require',
+    });
+    expect(post).toHaveBeenCalledWith('/credentials/codex-identity/initialize', {});
+    expect(post).toHaveBeenCalledWith('/credentials/codex-identity/rotate', {
+      name: 'synthetic.json',
+      auth_index: 'synthetic-index',
+      confirm: 'ROTATE',
+    });
+  });
+});
+
+describe('UUID and historical log identifiers', () => {
+  for (const id of ['00000000', 'deadbeef', '019f2222-4444-7777-8abc-0000deadbeef']) {
+    test(`parses and downloads the exact ${id} identifier without truncating`, async () => {
+      const row = parseLogLine(
+        `[2026-09-30 10:00:00] [${id}] [info] [gin.go:20] 200 | 1ms | 127.0.0.1 | POST /v1/responses`
+      );
+      expect(row.requestId).toBe(id);
+      expect(row.level).toBe('info');
+      const get = spyOn(apiClient, 'getRaw').mockResolvedValue({ data: new Blob(['fixture']) });
+      restorers.push(() => get.mockRestore());
+      await logsApi.downloadRequestLogById(id);
+      expect(get.mock.calls[0][0]).toBe(`/observability/logs/requests/${id}`);
+      expect(get.mock.calls[0][1]?.responseType).toBe('blob');
+    });
+  }
+  test('named full UUID remains distinct from an execution UUID in the message', () => {
+    const id = '019f2222-4444-7777-8abc-0000deadbeef';
+    const row = parseLogLine(
+      `[2026-09-30 10:00:00] [info] request_id=${id} | execution_id=9bdf984f-25bb-499e-93b5-796929847c30`
+    );
+    expect(row.requestId).toBe(id);
+  });
+  test('distinct full UUIDs sharing a suffix remain distinct in the UI request', async () => {
+    const get = spyOn(apiClient, 'getRaw').mockResolvedValue({ data: new Blob(['fixture']) });
+    restorers.push(() => get.mockRestore());
+    const ids = ['019f2222-4444-7777-8abc-0000deadbeef', '019f3333-5555-7777-8abc-1111deadbeef'];
+    for (const id of ids) await logsApi.downloadRequestLogById(id);
+    expect(get.mock.calls.map((call) => call[0])).toEqual(
+      ids.map((id) => `/observability/logs/requests/${id}`)
+    );
+    // The backend still resolves filenames by the short suffix. This test only
+    // proves preservation of the supplied UI identifier, not unique file lookup.
+  });
+});
diff --git a/tests/forkV810ClientConfig.test.ts b/tests/forkV810ClientConfig.test.ts
new file mode 100644
index 0000000..101457c
--- /dev/null
+++ b/tests/forkV810ClientConfig.test.ts
@@ -0,0 +1,102 @@
+import { describe, expect, test } from 'bun:test';
+import { parse } from 'yaml';
+import { createElement } from 'react';
+import { renderToStaticMarkup } from 'react-dom/server';
+import { I18nextProvider } from 'react-i18next';
+import i18n from '@/i18n';
+import { runVisualConfig } from './helpers/visualConfig';
+import { buildConfigPatch } from '@/services/api/configPatch';
+import { SectionClientBehavior } from '@/features/config/components/sections/SectionClientBehavior';
+import { SectionOAuthBehavior } from '@/features/config/components/sections/SectionOAuthBehavior';
+import { DEFAULT_VISUAL_VALUES } from '@/types/visualConfig';
+
+const source = `config-version: 8
+client:
+  codex:
+    optimize-multi-agent-v2: true
+    enable-apply-patch: true
+    future: {zero: 0, off: false, values: []}
+  future-client: {option: retained}
+oauth:
+  providers:
+    codex:
+      credential-proxy-policy: require
+      credential-identity: {enabled: true}
+api-keys:
+  codex:
+    - name: synthetic
+      keys:
+        - {api-key: fixture, proxy-url: direct, concurrency-limit: 3}
+`;
+
+describe('v8.0.10 client compatibility scope', () => {
+  test('reads both native client options and defaults missing options to false', () => {
+    const loaded = runVisualConfig(source);
+    expect(loaded.visualValues.codexOptimizeMultiAgentV2).toBe(true);
+    expect(loaded.visualValues.codexEnableApplyPatch).toBe(true);
+    expect(loaded.visualDirty).toBe(false);
+    const missing = runVisualConfig('config-version: 8');
+    expect(missing.visualValues.codexOptimizeMultiAgentV2).toBe(false);
+    expect(missing.visualValues.codexEnableApplyPatch).toBe(false);
+  });
+
+  test('explicit false creates only the native client PATCH and preserves credential data', () => {
+    const form = runVisualConfig(source, [
+      { codexOptimizeMultiAgentV2: false, codexEnableApplyPatch: false },
+    ]);
+    const output = form.applyVisualChangesToYaml(source);
+    expect(buildConfigPatch(source, output)).toEqual({
+      patch: {
+        client: { codex: { 'optimize-multi-agent-v2': false, 'enable-apply-patch': false } },
+      },
+      deletions: [],
+    });
+    const before = parse(source);
+    const after = parse(output);
+    expect(after.oauth).toEqual(before.oauth);
+    expect(after['api-keys']).toEqual(before['api-keys']);
+    expect(after.client.codex.future).toEqual(before.client.codex.future);
+    expect(after.client['future-client']).toEqual(before.client['future-client']);
+    expect(after.oauth.providers.codex).not.toHaveProperty('optimize-multi-agent-v2');
+    expect(after.oauth.providers.codex).not.toHaveProperty('enable-apply-patch');
+  });
+
+  test('unrelated saves retain new and unknown client options, including concurrent changes', () => {
+    const latest = source.replace('enable-apply-patch: true', 'enable-apply-patch: false');
+    const form = runVisualConfig(source, [{ port: '8320' }]);
+    const output = form.applyVisualChangesToYaml(latest);
+    expect(parse(output).client).toEqual(parse(latest).client);
+    expect(buildConfigPatch(latest, output).patch).toEqual({ server: { port: 8320 } });
+  });
+
+  test('changing one client option leaves its sibling and API-key/OAuth groups unchanged', () => {
+    for (const option of ['codexOptimizeMultiAgentV2', 'codexEnableApplyPatch'] as const) {
+      const output = runVisualConfig(source, [{ [option]: false }]).applyVisualChangesToYaml(
+        source
+      );
+      const patch = buildConfigPatch(source, output).patch as { client: { codex: object } };
+      expect(Object.keys(patch.client.codex)).toHaveLength(1);
+      expect(parse(output).oauth).toEqual(parse(source).oauth);
+      expect(parse(output)['api-keys']).toEqual(parse(source)['api-keys']);
+    }
+  });
+
+  test('client controls are outside the OAuth-only section and honor read-only mode', () => {
+    const translations = i18n.cloneInstance({ lng: 'en' });
+    const props = { values: DEFAULT_VISUAL_VALUES, disabled: true, onChange: () => {} };
+    const render = (section: typeof SectionClientBehavior) =>
+      renderToStaticMarkup(
+        createElement(I18nextProvider, { i18n: translations }, createElement(section, props))
+      );
+    const client = render(SectionClientBehavior);
+    const oauth = render(SectionOAuthBehavior);
+    for (const id of ['codexOptimizeMultiAgentV2', 'codexEnableApplyPatch']) {
+      expect(client).toContain(`id="cfg-field-${id}"`);
+      expect(oauth).not.toContain(`id="cfg-field-${id}"`);
+    }
+    expect(client).toContain('OAuth and API-key routes');
+    const switches = client.match(/<input\b[^>]*type="checkbox"[^>]*>/g) ?? [];
+    expect(switches).toHaveLength(2);
+    for (const control of switches) expect(control).toContain('disabled=""');
+  });
+});
