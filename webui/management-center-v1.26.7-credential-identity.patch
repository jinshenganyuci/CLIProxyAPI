diff --git a/tests/upstream738MaxCompletionTokensAudit.test.ts b/tests/upstream738MaxCompletionTokensAudit.test.ts
new file mode 100644
index 0000000..b695d43
--- /dev/null
+++ b/tests/upstream738MaxCompletionTokensAudit.test.ts
@@ -0,0 +1,258 @@
+import { afterEach, describe, expect, test } from 'bun:test';
+import { apiClient } from '@/services/api/client';
+import { providersApi } from '@/services/api/providers';
+import { normalizeProviderGroups } from '@/services/api/transformers';
+import { readModelOptions } from '@/features/providers/modelOptions';
+import { buildOpenAIConfig } from '@/features/providers/useProviderWorkbench';
+import type { ProviderEntryFormInput } from '@/features/providers/types';
+
+const flag = 'use-max-completion-tokens';
+const originalGet = apiClient.get;
+const originalPut = apiClient.put;
+afterEach(() => {
+  apiClient.get = originalGet;
+  apiClient.put = originalPut;
+});
+const model = (name: string, value?: boolean) => ({
+  name,
+  alias: `${name}-alias`,
+  ...(value === undefined ? {} : { [flag]: value }),
+});
+const rawProvider = (models: unknown[]) => ({
+  name: 'audit-provider',
+  'base-url': 'https://fixture.invalid/v1',
+  keys: [],
+  'concurrency-limit': 7,
+  models,
+});
+const save = async (
+  oldModels: unknown[],
+  latestModels: unknown[],
+  nextModels?: ProviderEntryFormInput['models']
+) => {
+  let old = normalizeProviderGroups([rawProvider(oldModels)], true)[0]!;
+  const latest = rawProvider(latestModels);
+  const untouched = { ...rawProvider([model('other', true)]), name: 'untouched-provider' };
+  const writes: unknown[] = [];
+  const calls: string[] = [];
+  apiClient.get = (async (path: string) => {
+    calls.push(`GET ${path}`);
+    return { 'api-keys': { 'openai-compatibility': [untouched, latest] } };
+  }) as typeof apiClient.get;
+  apiClient.put = (async (path: string, body: unknown) => {
+    calls.push(`PUT ${path}`);
+    writes.push(body);
+    return undefined;
+  }) as typeof apiClient.put;
+  const hydrateModels = () =>
+    (nextModels ?? old.models!.map((m) => ({ ...m, alias: 'edited-alias' }))).map((row) => {
+      const current =
+        typeof row.sourceIndex === 'number'
+          ? old.models?.find((model) => model.sourceIndex === row.sourceIndex)
+          : undefined;
+      return {
+        ...(current ? readModelOptions(current) : {}),
+        ...row,
+        ...(current ? { useMaxCompletionTokens: current.useMaxCompletionTokens } : {}),
+      };
+    });
+  const form: ProviderEntryFormInput = {
+    apiKey: '',
+    name: old.name,
+    baseUrl: 'https://changed.invalid/v1',
+    proxyUrl: '',
+    prefix: 'changed',
+    disabled: false,
+    models: hydrateModels(),
+    headers: [],
+    excludedModelsText: '',
+    apiKeyEntries: [],
+  };
+  const different = JSON.stringify(oldModels) !== JSON.stringify(latestModels);
+  if (different) {
+    await expect(
+      providersApi.updateOpenAIProvider(old.name, 1, buildOpenAIConfig(form, old))
+    ).rejects.toThrow('configuration changed');
+    expect(writes).toHaveLength(0);
+    calls.length = 0;
+    old = normalizeProviderGroups([untouched, latest], true)[1]!;
+    // The native advanced editor reloads exposed model options after a stale write.
+    form.models = hydrateModels();
+  }
+  await providersApi.updateOpenAIProvider(old.name, 1, buildOpenAIConfig(form, old));
+  expect(calls).toEqual(['GET /config', 'PUT /config/api-keys/openai-compatibility']);
+  expect(writes).toHaveLength(1);
+  const result = writes[0] as Record<string, unknown>[];
+  expect(result[0]).toEqual(untouched);
+  expect(result[1]?.['concurrency-limit']).toBe(7);
+  return result[1]!.models as Record<string, unknown>[] | undefined;
+};
+
+describe('max completion tokens advanced-form preservation audit', () => {
+  for (const previous of [true, false, undefined])
+    for (const latest of [true, false, undefined]) {
+      test(`stale provider form ${String(previous)} preserves current model flag ${String(latest)}`, async () => {
+        const result = await save([model('same-model', previous)], [model('same-model', latest)]);
+        expect(result?.[0]?.name).toBe('same-model');
+        expect(result?.[0]?.alias).toBe('edited-alias');
+        if (latest === undefined) expect(result?.[0]).not.toHaveProperty(flag);
+        else expect(result?.[0]?.[flag]).toBe(latest);
+      });
+    }
+  test('reordered models preserve latest values by upstream name rather than array position', async () => {
+    const result = await save(
+      [model('a', true), model('b', false), model('c')],
+      [model('a', false), model('b', true), model('c')],
+      [
+        { name: 'c', sourceIndex: 2 },
+        { name: 'b', sourceIndex: 1 },
+        { name: 'a', sourceIndex: 0 },
+      ]
+    );
+    expect(result?.map((x) => [x.name, x[flag]])).toEqual([
+      ['c', undefined],
+      ['b', true],
+      ['a', false],
+    ]);
+  });
+  test('deleting a model and adding another does not transfer its enabled flag', async () => {
+    const result = await save(
+      [model('deleted', true), model('retained', false)],
+      [model('deleted', true), model('retained', true)],
+      [
+        { name: 'new-model', sourceIndex: null },
+        { name: 'retained', sourceIndex: 1 },
+      ]
+    );
+    expect(result?.[0]).not.toHaveProperty(flag);
+    expect(result?.[1]?.[flag]).toBe(true);
+    expect(result?.some((x) => x.name === 'deleted')).toBe(false);
+  });
+  test('renaming the upstream model creates a distinct default entry and cannot borrow its old preference', async () => {
+    const result = await save(
+      [model('old-model', true)],
+      [model('old-model', true)],
+      [{ name: 'renamed-model' }]
+    );
+    expect(result?.[0]?.name).toBe('renamed-model');
+    expect(result?.[0]).not.toHaveProperty(flag);
+  });
+  test('new models do not invent an enabled flag', async () => {
+    const result = await save([], [], [{ name: 'new-model' }]);
+    expect(result?.[0]).not.toHaveProperty(flag);
+  });
+  test('same upstream name with distinct aliases retains the selected row preference', async () => {
+    const first = { ...model('shared', true), alias: 'first-alias' };
+    const second = { ...model('shared', false), alias: 'second-alias' };
+    const result = await save(
+      [first, second],
+      [first, second],
+      [{ name: 'shared', alias: 'second-alias', sourceIndex: 1 }]
+    );
+    expect(result?.[0]?.[flag]).toBe(false);
+  });
+  test('reordering same-name aliases keeps each latest raw preference', async () => {
+    const first = { ...model('shared', false), alias: 'first-alias' };
+    const second = { ...model('shared', true), alias: 'second-alias' };
+    const result = await save(
+      [first, second],
+      [first, second],
+      [
+        { name: 'shared', alias: 'second-alias', sourceIndex: 1 },
+        { name: 'shared', alias: 'first-alias', sourceIndex: 0 },
+      ]
+    );
+    expect(result?.map((x) => [x.alias, x[flag]])).toEqual([
+      ['second-alias', true],
+      ['first-alias', false],
+    ]);
+  });
+  test('a new same-name alias before an unchanged row cannot steal the existing flag', async () => {
+    const existing = { ...model('shared', true), alias: 'existing-alias' };
+    const result = await save(
+      [existing],
+      [existing],
+      [
+        { name: 'shared', alias: 'new-alias', sourceIndex: null },
+        { name: 'shared', alias: 'existing-alias', sourceIndex: 0 },
+      ]
+    );
+    expect(result?.[0]).not.toHaveProperty(flag);
+    expect(result?.[1]?.[flag]).toBe(true);
+  });
+  test('one remaining alias edit retains its own row after exact peers are reserved', async () => {
+    const first = { ...model('shared', true), alias: 'first-alias' };
+    const second = { ...model('shared', false), alias: 'second-alias' };
+    const result = await save(
+      [first, second],
+      [first, second],
+      [
+        { name: 'shared', alias: 'renamed-second', sourceIndex: 1 },
+        { name: 'shared', alias: 'first-alias', sourceIndex: 0 },
+      ]
+    );
+    expect(result?.map((row) => [row.alias, row[flag]])).toEqual([
+      ['renamed-second', false],
+      ['first-alias', true],
+    ]);
+  });
+  test('an invalid persisted model row rejects before PUT instead of borrowing a same-name row', async () => {
+    const first = { ...model('shared', true), alias: 'first-alias' };
+    const second = { ...model('shared', false), alias: 'second-alias' };
+    let puts = 0;
+    const get = apiClient.get;
+    const put = apiClient.put;
+    apiClient.get = (async () => ({
+      'api-keys': { 'openai-compatibility': [rawProvider([first, second])] },
+    })) as typeof apiClient.get;
+    apiClient.put = (async () => {
+      puts += 1;
+    }) as typeof apiClient.put;
+    const existing = normalizeProviderGroups([rawProvider([first, second])], true)[0]!;
+    try {
+      await expect(
+        providersApi.updateOpenAIProvider(existing.name, 0, {
+          ...existing,
+          models: [{ name: 'shared', alias: 'renamed-alias', sourceIndex: 99 }],
+        })
+      ).rejects.toThrow('configuration changed');
+      expect(puts).toBe(0);
+    } finally {
+      apiClient.get = get;
+      apiClient.put = put;
+    }
+  });
+  test('two replacement aliases cannot claim the same persisted model row', async () => {
+    const existing = { ...model('shared', true), alias: 'old-alias' };
+    await expect(
+      save(
+        [existing],
+        [existing],
+        [
+          { name: 'shared', alias: 'first-new-alias', sourceIndex: 0 },
+          { name: 'shared', alias: 'second-new-alias', sourceIndex: 0 },
+        ]
+      )
+    ).rejects.toThrow('configuration changed');
+  });
+  test('duplicate model names keep flags attached to explicit persisted row identity', async () => {
+    const first = model('shared', true),
+      second = model('shared', false);
+    const result = await save(
+      [first, second],
+      [first, second],
+      [{ name: 'shared', alias: 'shared-alias', sourceIndex: 1 }]
+    );
+    expect(result?.[0]?.[flag]).toBe(false);
+  });
+  test('explicit self-alias and omitted alias identify the same model', async () => {
+    const raw = { name: 'self', alias: 'self', [flag]: true };
+    const result = await save([raw], [raw], [{ name: 'self', alias: 'self', sourceIndex: 0 }]);
+    expect(result?.[0]?.[flag]).toBe(true);
+    expect(result?.[0]?.alias).toBe('self');
+  });
+  test('removing the model list removes its flags with it', async () => {
+    const result = await save([model('a', true)], [model('a', true)], []);
+    expect(result).toBeUndefined();
+  });
+});
diff --git a/tests/v812SharedUpstreamMetadata.test.ts b/tests/v812SharedUpstreamMetadata.test.ts
