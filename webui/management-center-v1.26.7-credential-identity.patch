new file mode 100644
index 0000000..67d50fd
--- /dev/null
+++ b/src/services/api/configRevision.ts
@@ -0,0 +1,34 @@
+import type { AxiosRequestConfig } from 'axios';
+
+/** One read/modify/write operation; never shared across unrelated reads or connections. */
+export class ConfigRevision {
+  private etag: string | undefined;
+  private invalid = false;
+
+  constructor(readonly connectionRevision: number) {}
+
+  requestHeaders(revision: number): Record<string, string> {
+    if (this.invalid || revision !== this.connectionRevision) {
+      throw new Error('Configuration changed; refresh and try again.');
+    }
+    return this.etag ? { 'If-Match': this.etag } : {};
+  }
+
+  observe(headers: Record<string, unknown>): void {
+    const tag = Object.entries(headers).find(([key]) => key.toLowerCase() === 'etag')?.[1];
+    if (typeof tag === 'string' && /^"[^"\r\n]+"$/.test(tag)) {
+      this.etag = tag;
+    } else if (this.etag) {
+      // A write may have succeeded without readback. Never guess its next revision.
+      this.invalid = true;
+    }
+  }
+
+  invalidate(): void {
+    this.invalid = true;
+  }
+}
+
+export interface ConfigRequestConfig extends AxiosRequestConfig {
+  configRevision?: ConfigRevision;
+}
