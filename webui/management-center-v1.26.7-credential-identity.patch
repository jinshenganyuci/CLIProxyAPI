@@ -0,0 +1,90 @@
+import { afterEach, describe, expect, spyOn, test } from 'bun:test';
+import type { TFunction } from 'i18next';
+import { apiClient } from '../src/services/api/client';
+import { normalizeAuthFilesResponse } from '../src/services/api/authFiles';
+import { pluginsApi } from '../src/services/api/plugins';
+import { fetchPluginQuota, resetPluginQuotaRouteCache } from '../src/features/quota/providers/plugin/data';
+import { getQuotaCacheKey } from '../src/utils/quota/identity';
+import { resolveQuotaProviderType } from '../src/features/quota/logic';
+
+const mocks: { mockRestore(): void }[] = [];
+const t = ((key: string) => key) as TFunction;
+afterEach(() => {
+  for (const mock of mocks.splice(0)) mock.mockRestore();
+  resetPluginQuotaRouteCache();
+});
+const mockRequests = () => {
+  const list = spyOn(pluginsApi, 'list').mockRejectedValue(new Error('Plugin inventory unavailable'));
+  const post = spyOn(apiClient, 'post').mockResolvedValue({ summary: [] });
+  mocks.push(list, post);
+  return { list, post };
+};
+
+describe('v8.0.27 authoritative plugin quota routes', () => {
+  for (const field of ['quota_plugin_id', 'quotaPluginId']) {
+    test(`normalizes ${field} without changing auth identity or egress metadata`, () => {
+      const [file] = normalizeAuthFilesResponse({ files: [{
+        name: 'shared.json', id: 'plugin/credential-a', auth_index: 'index-a',
+        type: 'synthetic', supports_quota: true, quota_provider: 'shared',
+        [field]: ' selected-plugin ', proxy_url: 'socks5h://proxy.invalid:1080',
+        concurrency: { active: 1, limit: 3 },
+      }] }).files;
+      expect(file.quotaPluginId).toBe('selected-plugin');
+      expect(file.authIndex).toBe('index-a');
+      expect(file.id).toBe('plugin/credential-a');
+      expect(file.proxy_url).toBe('socks5h://proxy.invalid:1080');
+      expect(resolveQuotaProviderType(file)).toBe('plugin');
+    });
+  }
+
+  test('same-file credentials retain separate indices and use exact server plugin IDs without inventory', async () => {
+    const { list, post } = mockRequests();
+    const files = normalizeAuthFilesResponse({ files: ['a', 'b'].map((suffix) => ({
+      name: 'shared.json', id: `credential-${suffix}`, auth_index: `index-${suffix}`,
+      type: 'synthetic', supports_quota: true, quota_provider: 'shared',
+      quota_plugin_id: `plugin-${suffix}`,
+    })) }).files;
+    expect(getQuotaCacheKey(files[0])).not.toBe(getQuotaCacheKey(files[1]));
+    await Promise.all(files.map((file) => fetchPluginQuota(file, t)));
+    expect(post.mock.calls).toEqual([
+      ['/plugins/plugin-a/quota', { auth_index: 'index-a' }],
+      ['/plugins/plugin-b/quota', { auth_index: 'index-b' }],
+    ]);
+    expect(list).not.toHaveBeenCalled();
+  });
+
+  test('raw exact IDs are encoded and do not require a guessed provider', async () => {
+    const { list, post } = mockRequests();
+    await fetchPluginQuota({ name: 'selected.json', auth_index: 'selected', quota_plugin_id: 'plugin/selected' }, t);
+    expect(post).toHaveBeenCalledWith('/plugins/plugin%2Fselected/quota', { auth_index: 'selected' });
+    expect(list).not.toHaveBeenCalled();
+  });
+
+  test('a stale exact route failure never retries through another plugin', async () => {
+    const { list, post } = mockRequests();
+    post.mockRejectedValue(Object.assign(new Error('plugin not found'), { status: 404 }));
+    await expect(fetchPluginQuota({ name: 'selected.json', authIndex: 'selected', quotaPluginId: 'removed', quotaProvider: 'shared' }, t)).rejects.toThrow('plugin not found');
+    expect(post.mock.calls).toEqual([['/plugins/removed/quota', { auth_index: 'selected' }]]);
+    expect(list).not.toHaveBeenCalled();
+  });
+
+  test('an exact plugin ID never substitutes for a missing credential index', async () => {
+    const { list, post } = mockRequests();
+    await expect(fetchPluginQuota({ name: 'selected.json', quotaPluginId: 'selected' }, t)).rejects.toThrow('plugin_quota.missing_auth_index');
+    expect(post).not.toHaveBeenCalled();
+    expect(list).not.toHaveBeenCalled();
+  });
+
+  test('connection changes discard responses from the direct selected route', async () => {
+    const { list, post } = mockRequests();
+    let revision = 1;
+    mocks.push(spyOn(apiClient, 'getConnectionRevision').mockImplementation(() => revision));
+    post.mockImplementation(async () => {
+      revision = 2;
+      return { summary: [{ key: 'balance', label: 'Balance', value: 999 }] };
+    });
+    await expect(fetchPluginQuota({ name: 'selected.json', authIndex: 'selected', quotaPluginId: 'selected' }, t)).rejects.toThrow('connection changed');
+    expect(post).toHaveBeenCalledTimes(1);
+    expect(list).not.toHaveBeenCalled();
+  });
+});
diff --git a/tests/v830ResetReaderBinding.test.ts b/tests/v830ResetReaderBinding.test.ts
new file mode 100644
index 0000000..57ff06e
--- /dev/null
+++ b/tests/v830ResetReaderBinding.test.ts
@@ -0,0 +1,88 @@
+import { afterEach, expect, test } from 'bun:test';
+import { apiClient } from '@/services/api/client';
+import type { ApiCallRequest } from '@/services/api/apiCall';
+import { readClaudeResetGrants } from '@/services/api/claudeResetGrants';
+import { createResetGrantReader } from '@/features/quota/providers/claude/resetGrantReads';
+
+const originalPost = apiClient.post;
+afterEach(() => {
+  apiClient.post = originalPost;
+});
+const status = { eligible: true, grants: [] };
+const deferred = () => {
+  let resolve!: (value: { status_code: number; body: string }) => void;
+  const promise = new Promise<{ status_code: number; body: string }>((done) => {
+    resolve = done;
+  });
+  return { promise, resolve };
+};
+
+test('shared reset reads preserve separate selected credentials through the real serializer', async () => {
+  const calls: { path: string; request: ApiCallRequest }[] = [];
+  const pending: ReturnType<typeof deferred>[] = [];
+  apiClient.post = (async (path: string, request: ApiCallRequest) => {
+    calls.push({ path, request: structuredClone(request) });
+    const response = deferred();
+    pending.push(response);
+    return response.promise;
+  }) as typeof apiClient.post;
+  const read = createResetGrantReader({ revision: () => 1, read: readClaudeResetGrants });
+  const proxy = read('credential-proxy-a');
+  expect(read('credential-proxy-a')).toBe(proxy);
+  const direct = read('credential-direct-b');
+  expect(calls).toHaveLength(2);
+  expect(calls.map(({ request }) => request.authIndex)).toEqual([
+    'credential-proxy-a',
+    'credential-direct-b',
+  ]);
+  for (const { path, request } of calls) {
+    expect(path).toBe('/requests/api-call');
+    expect(request.url).toBe('https://api.anthropic.com/api/oauth/usage?cedar_ember=1&skip_spend=1');
+    expect(request.method).toBe('GET');
+    expect(request.header?.Authorization).toBe('Bearer $TOKEN$');
+    expect(request).not.toHaveProperty('proxy_url');
+  }
+  pending[0].resolve({ status_code: 200, body: JSON.stringify({ cedar_ember: status }) });
+  pending[1].resolve({ status_code: 200, body: JSON.stringify({ cedar_ember: status }) });
+  await Promise.all([proxy, direct]);
+  expect(calls).toHaveLength(2);
+});
+
+test('429 read has no unbound retry and an explicit retry retains the selected credential', async () => {
+  const calls: ApiCallRequest[] = [];
+  apiClient.post = (async (_path: string, request: ApiCallRequest) => {
+    calls.push(structuredClone(request));
+    return { status_code: 429, body: '{}' };
+  }) as typeof apiClient.post;
+  const read = createResetGrantReader({ revision: () => 1, read: readClaudeResetGrants });
+  await expect(read('credential-proxy-a')).rejects.toMatchObject({ code: 'rate_limited' });
+  expect(calls).toHaveLength(1);
+  await expect(read('credential-proxy-a')).rejects.toMatchObject({ code: 'rate_limited' });
+  expect(calls).toHaveLength(2);
+  expect(calls.every((request) => request.authIndex === 'credential-proxy-a')).toBe(true);
+  expect(calls.every((request) => !('proxy_url' in request))).toBe(true);
+});
+
+test('connection replacement rejects the old selected read and cannot erase its replacement', async () => {
+  let revision = 1;
+  const pending: ReturnType<typeof deferred>[] = [];
+  const calls: ApiCallRequest[] = [];
+  apiClient.post = (async (_path: string, request: ApiCallRequest) => {
+    calls.push(structuredClone(request));
+    const response = deferred();
+    pending.push(response);
+    return response.promise;
+  }) as typeof apiClient.post;
+  const read = createResetGrantReader({ revision: () => revision, read: readClaudeResetGrants });
+  const old = read('credential-proxy-a');
+  revision = 2;
+  const fresh = read('credential-proxy-a');
+  const rejected = old.catch((error: unknown) => error);
+  pending[0].resolve({ status_code: 200, body: JSON.stringify({ cedar_ember: status }) });
+  expect(await rejected).toMatchObject({ message: 'session' });
+  expect(read('credential-proxy-a')).toBe(fresh);
+  pending[1].resolve({ status_code: 200, body: JSON.stringify({ cedar_ember: status }) });
+  await fresh;
+  expect(calls).toHaveLength(2);
+  expect(calls.every((request) => request.authIndex === 'credential-proxy-a')).toBe(true);
+});
diff --git a/tests/v835ConfigRevision.test.ts b/tests/v835ConfigRevision.test.ts
new file mode 100644
index 0000000..500b004
--- /dev/null
+++ b/tests/v835ConfigRevision.test.ts
@@ -0,0 +1,152 @@
+import { afterEach, expect, test } from 'bun:test';
+import type { AxiosInstance, InternalAxiosRequestConfig } from 'axios';
+import { apiClient } from '@/services/api/client';
+import { ConfigRevision } from '@/services/api/configRevision';
+import { configFileApi } from '@/services/api/configFile';
+import { applyConfigPatch } from '@/services/api/configPatch';
+import { providersApi } from '@/services/api/providers';
+
+const instance = (apiClient as unknown as { instance: AxiosInstance }).instance;
+const originalAdapter = instance.defaults.adapter;
+const oldWindow = globalThis.window;
+afterEach(() => {
+  instance.defaults.adapter = originalAdapter;
+  globalThis.window = oldWindow;
+});
+const install = (
+  handle: (request: InternalAxiosRequestConfig) => {
+    etag?: string;
+    data?: unknown;
+    status?: number;
+  }
+) => {
+  globalThis.window = { dispatchEvent: () => true } as unknown as Window & typeof globalThis;
+  instance.defaults.adapter = async (request) => {
+    const result = handle(request);
+    if (result.status === 412) {
+      throw Object.assign(new Error('Configuration changed'), {
+        isAxiosError: true,
+        response: { status: 412, data: { error: 'Configuration changed' } },
+      });
+    }
+    return {
+      config: request,
+      status: 200,
+      statusText: 'OK',
+      headers: result.etag ? { etag: result.etag } : {},
+      data: result.data ?? { status: 'ok' },
+    };
+  };
+};
+
+test('source save uses exactly its read ETag and exposes 412 without blind retry', async () => {
+  const calls: InternalAxiosRequestConfig[] = [];
+  install((request) => {
+    calls.push(request);
+    return request.method === 'get'
+      ? { etag: '"old"', data: 'server: {port: 8317}' }
+      : { status: 412 };
+  });
+  const revision = new ConfigRevision(apiClient.getConnectionRevision());
+  const source = await configFileApi.fetchConfigYaml(revision);
+  await expect(configFileApi.saveConfigYaml(source, revision)).rejects.toMatchObject({
+    status: 412,
+  });
+  expect(calls).toHaveLength(2);
+  expect(calls[1].headers.get('If-Match')).toBe('"old"');
+  await expect(configFileApi.saveConfigYaml(source, revision)).rejects.toThrow('refresh');
+  expect(calls).toHaveLength(2);
+});
+
+test('visual multi-operation save advances only its own successful mutation ETags', async () => {
+  const headers: unknown[] = [];
+  install((request) => {
+    headers.push(request.headers.get('If-Match'));
+    return { etag: `"revision-${headers.length}"` };
+  });
+  const revision = new ConfigRevision(apiClient.getConnectionRevision());
+  revision.observe({ etag: '"initial"' });
+  await applyConfigPatch(
+    { patch: { server: { port: 9000 } }, emptyMaps: [['empty']], deletions: [['old']] },
+    apiClient.getConnectionRevision(),
+    revision
+  );
+  expect(headers).toEqual(['"initial"', '"revision-1"', '"revision-2"']);
+});
+
+test('missing write ETag stops subsequent visual mutations instead of dropping If-Match', async () => {
+  let calls = 0;
+  install(() => {
+    calls++;
+    return {};
+  });
+  const revision = new ConfigRevision(apiClient.getConnectionRevision());
+  revision.observe({ etag: '"initial"' });
+  await expect(
+    applyConfigPatch(
+      { patch: { server: { port: 9000 } }, deletions: [['old']] },
+      apiClient.getConnectionRevision(),
+      revision
+    )
+  ).rejects.toThrow('refresh');
+  expect(calls).toBe(1);
+});
+
+test('independent config snapshots cannot replace each other through a shared latest ETag', async () => {
+  const headers: unknown[] = [];
+  install((request) => {
+    headers.push(request.headers.get('If-Match'));
+    return { etag: '"written"' };
+  });
+  const first = new ConfigRevision(apiClient.getConnectionRevision());
+  const second = new ConfigRevision(apiClient.getConnectionRevision());
+  first.observe({ etag: '"first"' });
+  second.observe({ etag: '"second"' });
+  await configFileApi.saveConfigYaml('first', first);
+  await configFileApi.saveConfigYaml('second', second);
+  expect(headers).toEqual(['"first"', '"second"']);
+});
+
+test('provider creation preserves the read ETag while creating a new group array', async () => {
+  const calls: InternalAxiosRequestConfig[] = [];
+  install((request) => {
+    calls.push(request);
+    return request.method === 'get'
+      ? { etag: '"provider"', data: { 'api-keys': { codex: [] } } }
+      : { etag: '"saved"' };
+  });
+  await providersApi.createCodexConfig({
+    apiKey: 'synthetic-only',
+    proxyUrl: 'direct',
+    concurrencyLimit: 3,
+  });
+  expect(calls).toHaveLength(2);
+  expect(calls[1].headers.get('If-Match')).toBe('"provider"');
+  expect(JSON.parse(calls[1].data)[0].keys[0]).toMatchObject({
+    'proxy-url': 'direct',
+    'concurrency-limit': 3,
+  });
+});
+
+test('a changed management connection refuses the captured snapshot before transport', async () => {
+  let calls = 0;
+  install(() => {
+    calls++;
+    return {};
+  });
+  const revision = new ConfigRevision(apiClient.getConnectionRevision() - 1);
+  await expect(configFileApi.saveConfigYaml('synthetic', revision)).rejects.toThrow('refresh');
+  expect(calls).toBe(0);
+});
+
+test('older v8 responses without ETag keep existing compatibility', async () => {
+  const headers: unknown[] = [];
+  install((request) => {
+    headers.push(request.headers.get('If-Match'));
+    return { data: 'synthetic' };
+  });
+  const revision = new ConfigRevision(apiClient.getConnectionRevision());
+  await configFileApi.fetchConfigYaml(revision);
+  await configFileApi.saveConfigYaml('synthetic', revision);
+  expect(headers).toEqual([undefined, undefined]);
+});
diff --git a/tests/v8VisualConfig.test.ts b/tests/v8VisualConfig.test.ts
