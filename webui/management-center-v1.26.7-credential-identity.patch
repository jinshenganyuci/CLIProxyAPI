+import { afterEach, describe, expect, spyOn, test } from 'bun:test';
+import { createElement } from 'react';
+import { renderToStaticMarkup } from 'react-dom/server';
+import { createInstance, type TFunction } from 'i18next';
+import { I18nextProvider } from 'react-i18next';
+import { readFileSync } from 'node:fs';
+import { OAuthFlowDialog } from '../src/features/oauth/components/OAuthFlowDialog';
+import {
+  CREDENTIAL_PROXY_PROVIDERS,
+  credentialProxyURL,
+  shouldAutoStartOAuth,
+} from '../src/features/oauth/credentialProxy';
+import {
+  fetchPluginQuota,
+  resetPluginQuotaRouteCache,
+} from '../src/features/quota/providers/plugin/data';
+import { apiClient } from '../src/services/api/client';
+import { pluginsApi } from '../src/services/api/plugins';
+import en from '../src/i18n/locales/en.json';
+const i18n = createInstance();
+await i18n.init({ lng: 'en', resources: { en: { translation: en } } });
+const originals: { mockRestore: () => void }[] = [];
+afterEach(() => {
+  for (const mock of originals.splice(0)) mock.mockRestore();
+  resetPluginQuotaRouteCache();
+});
+const render = (providerId: string, state: Record<string, unknown> = {}) =>
+  renderToStaticMarkup(
+    createElement(
+      I18nextProvider,
+      { i18n },
+      createElement(OAuthFlowDialog, {
+        open: true,
+        providerId,
+        heading: { title: providerId, caption: '', icon: '' },
+        state,
+        text: (suffix: string) => i18n.t(`auth_login.${providerId.replace('-', '_')}_${suffix}`),
+        supportsCallback: ['codex', 'devin'].includes(providerId),
+        proxySettings: { mode: 'custom', url: 'socks5h://synthetic.invalid:1080', error: '' },
+        onProxyChange: () => {},
+        onStart: () => {},
+        onCancel: () => {},
+        onCallbackChange: () => {},
+        onCallbackSubmit: () => {},
+        onViewAuthFiles: () => {},
+        onClose: () => {},
+      })
+    )
+  );
+
+describe('v1.26 gallery retains credential-scoped egress', () => {
+  for (const provider of CREDENTIAL_PROXY_PROVIDERS) {
+    test(`${provider}: waits for proxy selection, then locks the input and offers cancellation`, () => {
+      expect(shouldAutoStartOAuth(provider)).toBe(false);
+      const idle = render(provider);
+      expect(idle).toContain('data-testid="credential-proxy-mode"');
+      expect(idle).toContain('type="password"');
+      expect(idle).not.toContain('disabled=""');
+      const active = render(provider, {
+        status: 'waiting',
+        state: 'synthetic-state',
+        url: 'https://auth.invalid',
+        userCode: 'SYNTHETIC',
+        expiresIn: ['meta', 'kimi', 'kimi-ai'].includes(provider) ? 600 : undefined,
+      });
+      expect(active).toMatch(/<select[^>]*disabled/);
+      expect(active).toMatch(/<input[^>]*data-testid="credential-proxy-url"[^>]*disabled/);
+      expect(active).toContain(
+        provider === 'codex'
+          ? en.auth_login.codex_cancel_login
+          : i18n.t(`auth_login.${provider.replace('-', '_')}_oauth_cancel`)
+      );
+      expect(active).not.toContain('auth_login.');
+    });
+  }
+  test('other native cards still start immediately and proxy modes retain their meanings', () => {
+    for (const provider of ['anthropic', 'antigravity', 'xai', 'plugin-fixture'])
+      expect(shouldAutoStartOAuth(provider)).toBe(true);
+    expect(credentialProxyURL({ mode: 'global', url: 'ignored', error: '' })).toBeUndefined();
+    expect(credentialProxyURL({ mode: 'direct', url: 'ignored', error: '' })).toBe('direct');
+    expect(
+      credentialProxyURL({ mode: 'custom', url: ' socks5h://synthetic.invalid:1080 ', error: '' })
+    ).toBe('socks5h://synthetic.invalid:1080');
+  });
+  test('success clears the proxy editor and the hook clears secrets on terminal lifecycle paths', () => {
+    expect(render('codex', { status: 'success' })).not.toContain('synthetic.invalid');
+    const hook = readFileSync('src/features/oauth/hooks/useOAuthFlows.ts', 'utf8');
+    expect(hook).toContain('setProxySettings({})');
+    expect(hook.match(/clearProxyDraft\(provider\)/g)).toHaveLength(2);
+    expect(hook).toContain('!attempt.isPolling()');
+    expect(hook).toContain('expiresIn: res.expiresIn');
+  });
+});
+
+describe('plugin quota management connection boundary', () => {
+  const file = { name: 'synthetic', auth_index: 'selected', quota_provider: 'fixture' };
+  const t = ((key: string) => key) as TFunction;
+  const plugins = {
+    plugins: [
+      { id: 'fixture-plugin', registered: true, supportsQuota: true, quotaProvider: 'fixture' },
+    ],
+  };
+  test('connection change while resolving plugin prevents any quota POST', async () => {
+    let revision = 1;
+    let resolve!: (value: typeof plugins) => void;
+    originals.push(spyOn(apiClient, 'getConnectionRevision').mockImplementation(() => revision));
+    originals.push(
+      spyOn(pluginsApi, 'list').mockImplementation(
+        () =>
+          new Promise((r) => {
+            resolve = r;
+          }) as ReturnType<typeof pluginsApi.list>
+      )
+    );
+    const post = spyOn(apiClient, 'post').mockResolvedValue({});
+    originals.push(post);
+    const promise = fetchPluginQuota(file, t);
+    revision = 2;
+    resolve(plugins);
+    await expect(promise).rejects.toThrow('connection changed');
+    expect(post).not.toHaveBeenCalled();
+  });
+  test('connection change during quota response discards it', async () => {
+    let revision = 1;
+    originals.push(spyOn(apiClient, 'getConnectionRevision').mockImplementation(() => revision));
+    originals.push(
+      spyOn(pluginsApi, 'list').mockResolvedValue(
+        plugins as Awaited<ReturnType<typeof pluginsApi.list>>
+      )
+    );
+    originals.push(
+      spyOn(apiClient, 'post').mockImplementation(async () => {
+        revision = 2;
+        return { summary: [{ key: 'balance', label: 'Balance', value: 1 }] };
+      })
+    );
+    await expect(fetchPluginQuota(file, t)).rejects.toThrow('connection changed');
+  });
+  test('actual route encodes plugin id and keeps canonical selected index without proxy override', async () => {
+    originals.push(
+      spyOn(pluginsApi, 'list').mockResolvedValue({
+        plugins: [{ ...plugins.plugins[0], id: 'fixture/plugin' }],
+      } as Awaited<ReturnType<typeof pluginsApi.list>>)
+    );
+    const post = spyOn(apiClient, 'post').mockResolvedValue({
+      summary: [{ key: 'balance', label: 'Balance', value: 0 }],
+    });
+    originals.push(post);
+    expect(
+      (await fetchPluginQuota({ ...file, authIndex: 'wrong-alias' }, t)).summary[0].value
+    ).toBe(0);
+    expect(post).toHaveBeenCalledWith('/plugins/fixture%2Fplugin/quota', {
+      auth_index: 'selected',
+    });
+  });
+});
