@@ -0,0 +1,133 @@
+import { isMap, parseDocument } from 'yaml';
+
+type Doc = ReturnType<typeof parseDocument>;
+
+// The server retains old OAuth spellings as aliases; shared upstream paths are canonical.
+export const SHARED_UPSTREAM_FIELDS = [
+  {
+    key: 'claudeHeaderTimezone',
+    old: 'oauth.providers.claude.header-defaults.timezone'.split('.'),
+    path: 'upstream.claude.header-defaults.timezone'.split('.'),
+  },
+  {
+    key: 'claudeModelLevelCooling',
+    old: 'oauth.providers.claude.model-level-cooling'.split('.'),
+    path: 'upstream.claude.model-level-cooling'.split('.'),
+  },
+  {
+    key: 'claudeDisableCloakMode',
+    old: 'oauth.providers.claude.disable-claude-cloak-mode'.split('.'),
+    path: 'upstream.claude.disable-claude-cloak-mode'.split('.'),
+  },
+  {
+    key: 'claudeCodeDisableCloakingModelList',
+    old: 'oauth.providers.claude.claude-code.disable-cloaking-model-list'.split('.'),
+    path: 'upstream.claude.disable-cloaking-model-list'.split('.'),
+  },
+  {
+    key: 'codexDisableCloaking',
+    old: 'oauth.providers.codex.disable-codex-cloaking'.split('.'),
+    path: 'upstream.codex.disable-codex-cloaking'.split('.'),
+  },
+  {
+    key: 'codexModelLevelCooling',
+    old: 'oauth.providers.codex.model-level-cooling'.split('.'),
+    path: 'upstream.codex.model-level-cooling'.split('.'),
+  },
+  {
+    key: 'codexStreamBootstrapBuffering',
+    old: 'oauth.providers.codex.stream-bootstrap-buffering'.split('.'),
+    path: 'upstream.codex.stream-bootstrap-buffering'.split('.'),
+  },
+  {
+    key: 'codexStreamBootstrapTimeout',
+    old: 'oauth.providers.codex.stream-bootstrap-timeout'.split('.'),
+    path: 'upstream.codex.stream-bootstrap-timeout'.split('.'),
+  },
+  {
+    key: 'codexOrphanDelegationCompatibility',
+    old: 'oauth.providers.codex.orphan-delegation-compatibility'.split('.'),
+    path: 'upstream.codex.orphan-delegation-compatibility'.split('.'),
+  },
+  {
+    key: 'codexResponseSteering',
+    old: 'oauth.providers.codex.response-steering'.split('.'),
+    path: 'upstream.codex.response-steering'.split('.'),
+  },
+  {
+    key: 'xaiInjectXSearch',
+    old: 'oauth.providers.xai.inject-x-search'.split('.'),
+    path: 'upstream.xai.inject-x-search'.split('.'),
+  },
+  {
+    key: 'claudeHeaderUserAgent',
+    old: 'oauth.providers.claude.header-defaults.user-agent'.split('.'),
+    path: 'upstream.claude.header-defaults.user-agent'.split('.'),
+  },
+  {
+    key: 'claudeHeaderPackageVersion',
+    old: 'oauth.providers.claude.header-defaults.package-version'.split('.'),
+    path: 'upstream.claude.header-defaults.package-version'.split('.'),
+  },
+  {
+    key: 'claudeHeaderRuntimeVersion',
+    old: 'oauth.providers.claude.header-defaults.runtime-version'.split('.'),
+    path: 'upstream.claude.header-defaults.runtime-version'.split('.'),
+  },
+  {
+    key: 'claudeHeaderOs',
+    old: 'oauth.providers.claude.header-defaults.os'.split('.'),
+    path: 'upstream.claude.header-defaults.os'.split('.'),
+  },
+  {
+    key: 'claudeHeaderArch',
+    old: 'oauth.providers.claude.header-defaults.arch'.split('.'),
+    path: 'upstream.claude.header-defaults.arch'.split('.'),
+  },
+  {
+    key: 'claudeHeaderTimeout',
+    old: 'oauth.providers.claude.header-defaults.timeout'.split('.'),
+    path: 'upstream.claude.header-defaults.timeout'.split('.'),
+  },
+  {
+    key: 'claudeHeaderStabilizeDeviceProfile',
+    old: 'oauth.providers.claude.header-defaults.stabilize-device-profile'.split('.'),
+    path: 'upstream.claude.header-defaults.stabilize-device-profile'.split('.'),
+  },
+] as const;
+
+function parents(doc: Doc, path: readonly string[]) {
+  for (let i = 1; i < path.length; i++) {
+    const parent = path.slice(0, i);
+    if (!isMap(doc.getIn(parent, true))) doc.setIn(parent, doc.createNode({}));
+  }
+}
+
+/** Read aliases without rewriting the loaded source or replacing explicit false/null. */
+export function projectSharedUpstreamRead(source: Doc): Doc {
+  const doc = source.clone();
+  for (const { old, path } of SHARED_UPSTREAM_FIELDS) {
+    if (doc.hasIn(path) || !doc.hasIn(old)) continue;
+    parents(doc, path);
+    doc.setIn(path, doc.getIn(old, true));
+  }
+  return doc;
+}
+
+/** Move only edited legacy fields; retain unrelated OAuth fields and AST comments. */
+export function prepareSharedUpstreamEdits(doc: Doc, dirty: ReadonlySet<string>) {
+  for (const { key, old, path } of SHARED_UPSTREAM_FIELDS) {
+    if (!dirty.has(key) || !doc.hasIn(old)) continue;
+    if (!doc.hasIn(path)) {
+      parents(doc, path);
+      doc.setIn(path, doc.getIn(old, true));
+    }
+    doc.deleteIn(old);
+    for (let i = old.length - 1; i > 0; i--) {
+      const parent = old.slice(0, i);
+      const node = doc.getIn(parent, true);
+      if (!isMap(node) || node.items.length) break;
+      doc.deleteIn(parent);
+    }
+  }
+}
