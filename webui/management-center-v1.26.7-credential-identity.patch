@@ -0,0 +1,56 @@
+import { useId } from 'react';
+import { useTranslation } from 'react-i18next';
+import { DEFAULT_CREDENTIAL_PROXY, type CredentialProxySettings } from '../credentialProxy';
+
+export function CredentialProxyFields({
+  provider,
+  value = DEFAULT_CREDENTIAL_PROXY,
+  disabled,
+  onChange,
+}: {
+  provider: string;
+  value?: CredentialProxySettings;
+  disabled: boolean;
+  onChange: (next: Partial<CredentialProxySettings>) => void;
+}) {
+  const { t } = useTranslation();
+  const id = useId();
+  const prefix = `auth_login.${provider.replace('-', '_')}`;
+  return (
+    <div data-credential-proxy={provider}>
+      <label htmlFor={`${id}-mode`}>{t(`${prefix}_proxy_label`)}</label>
+      <select
+        id={`${id}-mode`}
+        className="input"
+        data-testid="credential-proxy-mode"
+        value={value.mode}
+        disabled={disabled}
+        onChange={(event) =>
+          onChange({ mode: event.target.value as CredentialProxySettings['mode'], error: '' })
+        }
+      >
+        <option value="global">{t(`${prefix}_proxy_global`)}</option>
+        <option value="custom">{t(`${prefix}_proxy_custom`)}</option>
+        <option value="direct">{t(`${prefix}_proxy_direct`)}</option>
+      </select>
+      {value.mode === 'custom' && (
+        <>
+          <label htmlFor={`${id}-url`}>{t(`${prefix}_proxy_url_label`)}</label>
+          <input
+            id={`${id}-url`}
+            className="input"
+            data-testid="credential-proxy-url"
+            type="password"
+            value={value.url}
+            disabled={disabled}
+            autoComplete="off"
+            spellCheck={false}
+            onChange={(event) => onChange({ url: event.target.value, error: '' })}
+          />
+        </>
+      )}
+      <p>{t(`${prefix}_${value.mode === 'global' ? 'proxy_global_hint' : 'proxy_hint'}`)}</p>
+      {value.error && <p role="alert">{value.error}</p>}
+    </div>
+  );
+}
