diff --git a/src/features/oauth/credentialProxy.ts b/src/features/oauth/credentialProxy.ts
new file mode 100644
index 0000000..e6debb4
--- /dev/null
+++ b/src/features/oauth/credentialProxy.ts
@@ -0,0 +1,34 @@
+export const CREDENTIAL_PROXY_PROVIDERS = new Set(['codex', 'devin', 'meta', 'kimi', 'kimi-ai']);
+
+export interface CredentialProxySettings {
+  mode: 'global' | 'custom' | 'direct';
+  url: string;
+  error: string;
+}
+
+export const DEFAULT_CREDENTIAL_PROXY: CredentialProxySettings = {
+  mode: 'global',
+  url: '',
+  error: '',
+};
+
+export const credentialProxyURL = (settings?: CredentialProxySettings): string | undefined =>
+  settings?.mode === 'direct'
+    ? 'direct'
+    : settings?.mode === 'custom'
+      ? settings.url.trim()
+      : undefined;
+
+/** Proxy-capable flows must let the operator choose an egress before acquisition. */
+export const shouldAutoStartOAuth = (provider: string): boolean =>
+  !CREDENTIAL_PROXY_PROVIDERS.has(provider);
+
+/** Forget only the selected dialog's secret draft without mutating an acquired request. */
+export function discardCredentialProxyDraft(
+  settings: Record<string, CredentialProxySettings>,
+  provider: string
+): Record<string, CredentialProxySettings> {
+  const draft = settings[provider];
+  if (!draft || (!draft.url && !draft.error)) return settings;
+  return { ...settings, [provider]: { ...draft, url: '', error: '' } };
+}
