+++ b/tests/v824OAuthProxyClose.test.ts
@@ -0,0 +1,38 @@
+import { describe, expect, test } from 'bun:test';
+import {
+  credentialProxyURL,
+  discardCredentialProxyDraft,
+  type CredentialProxySettings,
+} from '../src/features/oauth/credentialProxy';
+
+describe('closing OAuth dialogs discards only transient proxy secrets', () => {
+  for (const mode of ['custom', 'direct', 'global'] as const) {
+    test(`${mode}: preserves the chosen mode, other providers and any acquired request snapshot`, () => {
+      const selected: CredentialProxySettings = {
+        mode,
+        url: 'socks5h://synthetic:secret@proxy.invalid:1080',
+        error: 'synthetic error',
+      };
+      const sibling: CredentialProxySettings = {
+        mode: 'custom',
+        url: 'http://other.invalid:8080',
+        error: '',
+      };
+      const settings = { codex: selected, meta: sibling };
+      const acquiredProxy = credentialProxyURL(selected);
+      const cleared = discardCredentialProxyDraft(settings, 'codex');
+      expect(cleared.codex).toEqual({ mode, url: '', error: '' });
+      expect(cleared.meta).toBe(sibling);
+      expect(settings.codex).toBe(selected);
+      expect(selected.url).toBe('socks5h://synthetic:secret@proxy.invalid:1080');
+      expect(credentialProxyURL(selected)).toBe(acquiredProxy);
+      if (mode === 'custom') expect(credentialProxyURL(cleared.codex)).toBe('');
+      expect(discardCredentialProxyDraft(cleared, 'codex')).toBe(cleared);
+    });
+  }
+  test('closing a provider without a draft does not introduce a global fallback selection', () => {
+    const settings = { meta: { mode: 'direct' as const, url: '', error: '' } };
+    expect(discardCredentialProxyDraft(settings, 'codex')).toBe(settings);
+    expect(settings).not.toHaveProperty('codex');
+  });
+});
