+import { describe, expect, test } from 'bun:test';
+import { createInstance } from 'i18next';
+import vi from '../src/i18n/locales/vi.json';
+
+const translation = createInstance();
+await translation.init({ lng: 'vi', fallbackLng: false, resources: { vi: { translation: vi } } });
+
+describe('v1.25.4 Vietnamese fork controls', () => {
+  test('renders actual concurrency occupancy and the default without fallback', () => {
+    expect(translation.t('auth_files.concurrency_usage', { count: 3, limit: 10 })).toBe(
+      '3 / 10 yêu cầu đang xử lý'
+    );
+    expect(vi.auth_files.concurrency_hint).toContain('10');
+    expect(vi.auth_files.concurrency_managed_hint).toContain('Home');
+  });
+  test('uses the current Devin callback and distinguishes browser device authorization', () => {
+    expect(vi.auth_login.devin_callback_placeholder).toBe(
+      'http://127.0.0.1:<server-port>/callback?code=...&state=...'
+    );
+    expect(vi.auth_login.devin_callback_hint).not.toContain('/devin/callback');
+    for (const provider of ['meta', 'kimi', 'kimi_ai'] as const) {
+      expect(vi.auth_login[`${provider}_proxy_hint`]).toContain('trình duyệt');
+      expect(translation.t(`auth_login.${provider}_expiry_hint`, { minutes: 5 })).toContain('5');
+    }
+  });
+  test('explains shared upstream/client scope and template apply_patch preservation', () => {
+    const additions = vi.config_management.visual.additions;
+    expect(additions.oauthHint).toContain('OAuth và API key');
+    expect(additions.clientHint).toContain('OAuth và API key');
+    expect(additions.codexEnableApplyPatch.hint).toContain('Khi tắt');
+    expect(additions.codexEnableApplyPatch.hint).toContain('freeform apply_patch');
+  });
+  test('interpolates identity actions while retaining explicit credential proxy policy', () => {
+    expect(translation.t('codex_credential_identity.initialize_confirm', { count: 3 })).toContain(
+      '3'
+    );
+    expect(
+      translation.t('codex_credential_identity.rotate_confirm', { name: 'synthetic' })
+    ).toContain('synthetic');
+    expect(vi.codex_credential_identity.strict_proxy_desc).toContain('proxy_url');
+    expect(vi.codex_credential_identity.strict_proxy_desc).toContain('direct');
+  });
+});
diff --git a/tests/v820UpgradeCompatibility.test.ts b/tests/v820UpgradeCompatibility.test.ts
new file mode 100644
index 0000000..b6d9618
--- /dev/null
+++ b/tests/v820UpgradeCompatibility.test.ts
@@ -0,0 +1,166 @@
+import { afterEach, describe, expect, test } from 'bun:test';
+import type { TFunction } from 'i18next';
+import { parse, stringify } from 'yaml';
+import { apiClient } from '../src/services/api/client';
+import { providersApi } from '../src/services/api/providers';
+import { normalizeProviderGroups } from '../src/services/api/transformers';
+import { CODEX_CONFIG } from '../src/features/quota/providers/codex/data';
+import { CODEX_RATE_LIMIT_RESET_CREDITS_CONSUME_URL } from '../src/utils/quota';
+import { runVisualConfig } from './helpers/visualConfig';
+import { buildConfigPatch } from '../src/services/api/configPatch';
+import type { OpenAIProviderConfig, ProviderKeyConfig } from '../src/types';
+
+const originalGet = apiClient.get,
+  originalPut = apiClient.put,
+  originalPost = apiClient.post;
+afterEach(() => {
+  apiClient.get = originalGet;
+  apiClient.put = originalPut;
+  apiClient.post = originalPost;
+});
+
+describe('v8.0.20 native and fork save boundaries', () => {
+  for (const family of ['codex', 'openai-compatibility', 'keyless'] as const) {
+    test(`${family}: strips obsolete model tests and readonly indices without changing opaque or model fields`, async () => {
+      const provider = family === 'codex' ? 'codex' : 'openai-compatibility';
+      const opaque = {
+        auth_index: 'owned-index',
+        'auth-index': 'owned-old',
+        'test-model': 'owned-test',
+      };
+      const model = {
+        name: 'synthetic',
+        'test-model': 'obsolete',
+        'is-compat': true,
+        'force-mapping': true,
+        'support-configuration-update': true,
+        'max-context-length': 12345,
+        thinking: { levels: ['low', 'high'] },
+        future: opaque,
+      };
+      const group = {
+        name: 'synthetic',
+        'base-url': 'https://synthetic.invalid',
+        ...(provider === 'openai-compatibility' ? { 'test-model': 'obsolete' } : {}),
+        auth_index: 'readonly-group',
+        'auth-index': 'readonly-old-group',
+        'concurrency-limit': 8,
+        headers: opaque,
+        future: opaque,
+        models: [model],
+        keys:
+          family === 'keyless'
+            ? []
+            : [
+                {
+                  'api-key': 'synthetic-key',
+                  'proxy-url': 'socks5h://proxy.invalid:1080',
+                  'concurrency-limit': 3,
+                  auth_index: 'readonly-key',
+                  'auth-index': 'readonly-old-key',
+                  headers: opaque,
+                  future: opaque,
+                  models: [model],
+                },
+              ],
+      };
+      let output: Record<string, unknown>[] | undefined;
+      apiClient.get = (async () => ({
+        'api-keys': { [provider]: [structuredClone(group)] },
+      })) as typeof apiClient.get;
+      apiClient.put = (async (path: string, value: unknown) => {
+        expect(path).toBe(`/config/api-keys/${provider}`);
+        output = value as Record<string, unknown>[];
+      }) as typeof apiClient.put;
+      if (provider === 'codex') {
+        const row = normalizeProviderGroups([group])[0] as ProviderKeyConfig;
+        await providersApi.updateCodexConfig(row.apiKey, row.baseUrl, { ...row, priority: 2 });
+      } else {
+        const row = normalizeProviderGroups([group], true)[0] as OpenAIProviderConfig;
+        await providersApi.updateOpenAIProvider(row.name, 0, { ...row, priority: 2 });
+      }
+      expect(output).toHaveLength(1);
+      const saved = output![0];
+      expect(saved.auth_index).toBeUndefined();
+      expect(saved['auth-index']).toBeUndefined();
+      expect(saved['test-model']).toBeUndefined();
+      expect(saved['concurrency-limit']).toBe(8);
+      expect(saved.headers).toEqual(opaque);
+      expect(saved.future).toEqual(opaque);
+      const { ['test-model']: omitted, ...cleanModel } = model;
+      void omitted;
+      expect(saved.models).toEqual([cleanModel]);
+      for (const key of saved.keys as Record<string, unknown>[]) {
+        expect(key.auth_index).toBeUndefined();
+        expect(key['auth-index']).toBeUndefined();
+        expect(key['proxy-url']).toBe('socks5h://proxy.invalid:1080');
+        expect(key['concurrency-limit']).toBe(3);
+        expect(key.headers).toEqual(opaque);
+        expect(key.future).toEqual(opaque);
+        expect(key.models).toEqual([cleanModel]);
+      }
+      expect(group.auth_index).toBe('readonly-group');
+      expect(group.models[0]['test-model']).toBe('obsolete');
+    });
+  }
+  test('GitHub token edits create a narrow patch and retain current plugin-owned fields', () => {
+    const before = stringify({
+      server: { port: 8317, 'github-token': 'synthetic-old', future: { enabled: false } },
+      plugins: { configs: { sample: { auth_index: 'owned', zero: 0 } } },
+      upstream: { codex: { 'response-steering': true } },
+    });
+    const current = parse(before);
+    current.plugins.configs.sample.extra = 'new';
+    const latest = stringify(current);
+    for (const token of [' synthetic-replacement ', '']) {
+      const after = runVisualConfig(before, [{ githubToken: token }]).applyVisualChangesToYaml(
+        latest
+      );
+      expect(buildConfigPatch(latest, after)).toEqual({
+        patch: { server: { 'github-token': token.trim() } },
+        deletions: [],
+      });
+      expect(parse(after).plugins).toEqual(current.plugins);
+      expect(parse(after).server.future).toEqual({ enabled: false });
+    }
+  });
+  for (const code of ['reset', 'already_redeemed']) {
+    test(`${code}: actual management serializers keep the selected credential for redemption, clear and refresh`, async () => {
+      const calls: { path: string; body: Record<string, unknown> }[] = [];
+      apiClient.post = (async (path: string, body: Record<string, unknown>) => {
+        calls.push({ path, body: structuredClone(body) });
+        if (path === '/routing/cooldown/reset')
+          return { status: 'ok', auth_index: 'selected-index', models: [] };
+        return {
+          status_code: 200,
+          body: JSON.stringify(
+            body.url === CODEX_RATE_LIMIT_RESET_CREDITS_CONSUME_URL ? { code } : {}
+          ),
+        };
+      }) as typeof apiClient.post;
+      await CODEX_CONFIG.resetQuota!(
+        {
+          name: 'synthetic.json',
+          type: 'codex',
+          auth_index: 'selected-index',
+          authIndex: 'wrong-alias',
+        },
+        ((key: string) => key) as TFunction
+      );
+      expect(calls[0].path).toBe('/requests/api-call');
+      expect(calls[0].body.authIndex).toBe('selected-index');
+      expect(calls[1]).toEqual({
+        path: '/routing/cooldown/reset',
+        body: { auth_index: 'selected-index' },
+      });
+      for (const call of calls.filter((x) => x.path === '/requests/api-call')) {
+        expect(call.body.authIndex).toBe('selected-index');
+        expect(call.body.proxy_url).toBeUndefined();
+        expect(JSON.stringify(call.body)).toContain('$TOKEN$');
+      }
+      expect(
+        calls.filter((x) => x.body.url === CODEX_RATE_LIMIT_RESET_CREDITS_CONSUME_URL)
+      ).toHaveLength(1);
+    });
+  }
+});
diff --git a/tests/v823OAuthQuotaFork.test.ts b/tests/v823OAuthQuotaFork.test.ts
