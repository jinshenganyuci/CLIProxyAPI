+      {
+        name: 'synthetic',
+        'base-url': 'https://claude.invalid',
+        keys: [
+          {
+            'api-key': 'synthetic-key',
+            'proxy-url': 'socks5h://proxy.invalid:1080',
+            'concurrency-limit': 3,
+            ...(flag === undefined ? {} : { 'native-tool-search': flag }),
+            headers: { 'native-tool-search': 'opaque-header' },
+            auth_index: 'selected',
+          },
+          { 'api-key': 'sibling', 'native-tool-search': false },
+        ],
+      },
