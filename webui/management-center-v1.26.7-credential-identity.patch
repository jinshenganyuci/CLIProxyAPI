+  plugins: { configs: { sample: { zero: 0, opaque: { 'native-tool-search': false } } } },
+});
+
+describe('v8.0.24 Claude tool-search fields on existing editors', () => {
+  for (const flag of [true, false, undefined]) {
+    test(`${String(flag)}: unrelated visual edit retains global and per-key values`, () => {
+      const before = stringify(fixture(flag));
+      const after = runVisualConfig(before, [{ port: '8318' }]).applyVisualChangesToYaml(before);
+      expect(parse(after).upstream).toEqual(parse(before).upstream);
+      expect(parse(after)['api-keys']).toEqual(parse(before)['api-keys']);
+      expect(parse(after).plugins).toEqual(parse(before).plugins);
+      expect(buildConfigPatch(before, after)).toEqual({
+        patch: { server: { port: 8318 } },
+        deletions: [],
+      });
+    });
+    test(`${String(flag)}: real provider form saves unknown key option without creating a group option`, async () => {
+      const state = fixture(flag);
+      const current = normalizeProviderGroups(state['api-keys'].claude)[0] as ProviderKeyConfig;
+      let written: (typeof state)['api-keys']['claude'] | undefined;
+      apiClient.get = (async () => structuredClone(state)) as typeof apiClient.get;
+      apiClient.put = (async (path: string, body: unknown) => {
+        expect(path).toBe('/config/api-keys/claude');
+        written = body as typeof written;
+      }) as typeof apiClient.put;
+      await providersApi.updateClaudeConfig(
+        current.apiKey,
+        current.baseUrl,
+        buildProviderKeyConfig(
+          'claude',
+          {
+            apiKey: '',
+            name: 'synthetic',
+            baseUrl: current.baseUrl!,
+            proxyUrl: current.proxyUrl!,
+            priority: 7,
+            prefix: '',
+            disabled: false,
+            models: [],
+            headers: [{ key: 'native-tool-search', value: 'opaque-header' }],
+            excludedModelsText: '',
+          },
+          current
+        )
+      );
+      expect(written).toHaveLength(1);
+      expect(written![0]).not.toHaveProperty('native-tool-search');
+      expect(written![0].keys[0]['native-tool-search']).toBe(flag);
+      expect(Object.hasOwn(written![0].keys[0], 'native-tool-search')).toBe(flag !== undefined);
+      expect(written![0].keys[0]).toMatchObject({
+        'proxy-url': 'socks5h://proxy.invalid:1080',
+        'concurrency-limit': 3,
+        priority: 7,
+        headers: { 'native-tool-search': 'opaque-header' },
+      });
+      expect(written![0].keys[0].auth_index).toBeUndefined();
+      expect(written![0].keys[1]).toEqual(state['api-keys'].claude[0].keys[1]);
+    });
+    test(`${String(flag)}: YAML source submits the values without narrowing the schema`, async () => {
+      const yaml = stringify(fixture(flag));
+      const calls: unknown[][] = [];
+      apiClient.put = (async (...args: unknown[]) => {
+        calls.push(args);
+      }) as typeof apiClient.put;
+      await configFileApi.saveConfigYaml(yaml);
+      expect(calls).toHaveLength(1);
+      expect(calls[0][0]).toBe('/config.yaml');
+      expect(calls[0][1]).toBe(yaml);
+    });
+  }
+  test('Vertex group interactions and explicit key override survive a real provider form save', async () => {
+    const group = {
+      name: 'vertex-fixture',
+      'base-url': 'https://vertex.invalid',
+      interactions: true,
+      keys: [
+        {
+          'api-key': 'vertex-a',
+          interactions: false,
+          'concurrency-limit': 3,
+          'proxy-url': 'direct',
+        },
+        { 'api-key': 'vertex-b' },
+      ],
+    };
+    const current = normalizeProviderGroups([group])[0] as ProviderKeyConfig;
+    let written: (typeof group)[] | undefined;
+    apiClient.get = (async () => ({
+      'api-keys': { vertex: [structuredClone(group)] },
+    })) as typeof apiClient.get;
+    apiClient.put = (async (path: string, body: unknown) => {
+      expect(path).toBe('/config/api-keys/vertex');
+      written = body as typeof written;
+    }) as typeof apiClient.put;
+    await providersApi.updateVertexConfig(
+      current.apiKey,
+      current.baseUrl,
+      buildProviderKeyConfig(
+        'vertex',
+        {
+          apiKey: '',
+          name: 'vertex-fixture',
+          baseUrl: current.baseUrl!,
+          proxyUrl: current.proxyUrl!,
+          priority: 4,
+          prefix: '',
+          disabled: false,
+          models: [],
+          headers: [],
+          excludedModelsText: '',
+        },
+        current
+      )
+    );
+    expect(written![0].interactions).toBe(true);
+    expect(written![0].keys[0]).toMatchObject({
+      interactions: false,
+      'concurrency-limit': 3,
+      'proxy-url': 'direct',
+      priority: 4,
+    });
+    expect(written![0].keys[1]).toEqual(group.keys[1]);
+  });
+});
