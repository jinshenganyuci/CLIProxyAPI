index 0000000..8b28ea8
--- /dev/null
+++ b/tests/v812SharedUpstreamMetadata.test.ts
@@ -0,0 +1,181 @@
+import { afterEach, describe, expect, test } from 'bun:test';
+import { parseDocument } from 'yaml';
+import { runVisualConfig } from './helpers/visualConfig';
+import { SHARED_UPSTREAM_FIELDS } from '../src/features/config/sharedUpstream';
+import { DEFAULT_VISUAL_VALUES } from '../src/types/visualConfig';
+import { apiClient } from '../src/services/api/client';
+import { providersApi } from '../src/services/api/providers';
+import { normalizeProviderGroups } from '../src/services/api/transformers';
+import type { ProviderKeyConfig, OpenAIProviderConfig } from '../src/types';
+import en from '../src/i18n/locales/en.json';
+import zh from '../src/i18n/locales/zh-CN.json';
+import tw from '../src/i18n/locales/zh-TW.json';
+import ru from '../src/i18n/locales/ru.json';
+import vi from '../src/i18n/locales/vi.json';
+
+const get = apiClient.get,
+  put = apiClient.put;
+afterEach(() => {
+  apiClient.get = get;
+  apiClient.put = put;
+});
+
+describe('v8.0.12 shared upstream and readonly provider metadata', () => {
+  for (const { key, old, path } of SHARED_UPSTREAM_FIELDS) {
+    test(`${key}: canonical presence wins and an edited old alias writes canonical only`, () => {
+      const boolean = typeof DEFAULT_VISUAL_VALUES[key] === 'boolean';
+      const doc = parseDocument(
+        'oauth: {providers: {codex: {credential-identity: {enabled: true}, credential-proxy-policy: require}}}\nplugins: {configs: {sample: {auth_index: owned, enabled: false}}}\n'
+      );
+      doc.setIn(old, boolean ? true : '20s');
+      const legacy = doc.toString();
+      expect(runVisualConfig(legacy).visualValues[key]).toBe(boolean ? true : '20s');
+      doc.setIn(path, boolean ? false : '30s');
+      expect(runVisualConfig(doc.toString()).visualValues[key]).toBe(boolean ? false : '30s');
+      doc.setIn(path, null);
+      expect(runVisualConfig(doc.toString()).visualValues[key]).toBe(
+        boolean ? DEFAULT_VISUAL_VALUES[key] : ''
+      );
+      const result = runVisualConfig(legacy, [{ [key]: boolean ? false : '25s' }]);
+      const out = parseDocument(result.applyVisualChangesToYaml(legacy));
+      expect(out.getIn(path)).toBe(boolean ? false : '25s');
+      expect(out.hasIn(old)).toBe(false);
+      expect(out.getIn(['oauth', 'providers', 'codex', 'credential-identity', 'enabled'])).toBe(
+        true
+      );
+      expect(out.getIn(['oauth', 'providers', 'codex', 'credential-proxy-policy'])).toBe('require');
+      expect(out.getIn(['plugins', 'configs', 'sample', 'auth_index'])).toBe('owned');
+    });
+  }
+  test('unrelated edits retain old aliases and canonical nulls without migrating source', () => {
+    const yaml =
+      'server: {port: 8317}\nupstream: {codex: {response-steering: null}}\noauth: {providers: {codex: {response-steering: true}}}\n';
+    const out = parseDocument(
+      runVisualConfig(yaml, [{ port: '8318' }]).applyVisualChangesToYaml(yaml)
+    );
+    expect(out.getIn(['upstream', 'codex', 'response-steering'])).toBe(null);
+    expect(out.getIn(['oauth', 'providers', 'codex', 'response-steering'])).toBe(true);
+  });
+  for (const name of ['codex', 'gemini', 'claude', 'meta', 'xai', 'interactions', 'vertex']) {
+    test(`${name}: underscore auth index reaches the selected provider credential`, () => {
+      const rows = normalizeProviderGroups([
+        {
+          name,
+          'base-url': 'https://synthetic.invalid',
+          keys: [
+            { 'api-key': 'same', 'proxy-url': 'direct', auth_index: 'selected-one' },
+            { 'api-key': 'same', 'proxy-url': 'http://proxy.invalid', auth_index: 'selected-two' },
+          ],
+        },
+      ]) as ProviderKeyConfig[];
+      expect(rows.map((row) => row.authIndex)).toEqual(['selected-one', 'selected-two']);
+    });
+  }
+  test('index-only refresh is not stale; every outgoing credential index is removed, nested headers survive', async () => {
+    const group = {
+      name: 'group',
+      'base-url': 'https://synthetic.invalid',
+      auth_index: 'group-before',
+      headers: { auth_index: 'header-owned', 'auth-index': 'hyphen-owned' },
+      keys: [
+        { 'api-key': 'same', 'proxy-url': 'direct', 'concurrency-limit': 3, auth_index: 'one' },
+        { 'api-key': 'same', 'proxy-url': 'http://proxy.invalid', auth_index: 'two' },
+      ],
+    };
+    const row = (normalizeProviderGroups([group]) as ProviderKeyConfig[])[0];
+    const current = structuredClone(group);
+    current.auth_index = 'group-after';
+    current.keys[0].auth_index = 'new-one';
+    current.keys[1].auth_index = 'new-two';
+    const calls: Record<string, unknown>[][] = [];
+    apiClient.get = (async () => ({ 'api-keys': { codex: [current] } })) as typeof apiClient.get;
+    apiClient.put = (async (_url: string, body: Record<string, unknown>[]) => {
+      calls.push(body);
+    }) as typeof apiClient.put;
+    await providersApi.updateCodexConfig(row.apiKey, row.baseUrl, { ...row, priority: 9 });
+    expect(calls).toHaveLength(1);
+    expect(calls[0][0].auth_index).toBeUndefined();
+    expect(calls[0][0].headers).toEqual(group.headers);
+    const keys = calls[0][0].keys as Record<string, unknown>[];
+    expect(keys[0]).toEqual({
+      'api-key': 'same',
+      'proxy-url': 'direct',
+      'concurrency-limit': 3,
+      priority: 9,
+    });
+    expect(keys[1]).toEqual({ 'api-key': 'same', 'proxy-url': 'http://proxy.invalid' });
+    expect(group.keys[0].auth_index).toBe('one');
+  });
+  for (const change of ['proxy', 'concurrency', 'header-index']) {
+    test(`real ${change} edits still reject stale provider snapshots`, async () => {
+      const group = {
+        name: 'group',
+        'base-url': 'https://synthetic.invalid',
+        keys: [
+          {
+            'api-key': 'same',
+            'proxy-url': 'direct',
+            'concurrency-limit': 3,
+            auth_index: 'old',
+            headers: { auth_index: 'owned' },
+          },
+        ],
+      };
+      const row = (normalizeProviderGroups([group]) as ProviderKeyConfig[])[0];
+      const current = structuredClone(group);
+      current.keys[0].auth_index = 'new';
+      if (change === 'proxy') current.keys[0]['proxy-url'] = 'http://changed.invalid';
+      if (change === 'concurrency') current.keys[0]['concurrency-limit'] = 4;
+      if (change === 'header-index') current.keys[0].headers.auth_index = 'changed-owned';
+      let writes = 0;
+      apiClient.get = (async () => ({ 'api-keys': { codex: [current] } })) as typeof apiClient.get;
+      apiClient.put = (async () => {
+        writes++;
+      }) as typeof apiClient.put;
+      await expect(
+        providersApi.updateCodexConfig(row.apiKey, row.baseUrl, { ...row, priority: 9 })
+      ).rejects.toThrow('refresh');
+      expect(writes).toBe(0);
+    });
+  }
+  test('keyless and keyed OpenAI-compatible indices remain readable and never persist', async () => {
+    const groups = [
+      {
+        name: 'fallback',
+        'base-url': 'https://synthetic.invalid',
+        auth_index: 'fallback-index',
+        'concurrency-limit': 8,
+        keys: [],
+      },
+      {
+        name: 'keyed',
+        'base-url': 'https://keyed.invalid',
+        keys: [{ 'api-key': 'key', auth_index: 'selected-key', 'concurrency-limit': 2 }],
+      },
+    ];
+    const rows = normalizeProviderGroups(groups, true) as OpenAIProviderConfig[];
+    expect(rows[0].authIndex).toBe('fallback-index');
+    expect(rows[1].apiKeyEntries[0].authIndex).toBe('selected-key');
+    let written: unknown;
+    apiClient.get = (async () => ({
+      'api-keys': { 'openai-compatibility': structuredClone(groups) },
+    })) as typeof apiClient.get;
+    apiClient.put = (async (_path: string, body: unknown) => {
+      written = body;
+    }) as typeof apiClient.put;
+    await providersApi.updateOpenAIProviderDisabled(0, true, rows[0].source);
+    expect(JSON.stringify(written)).not.toContain('auth_index');
+    expect((written as typeof groups)[0]['concurrency-limit']).toBe(8);
+  });
+  test('apply_patch disabled copy preserves the template capability in every locale', () => {
+    for (const locale of [en, zh, tw, ru, vi]) {
+      const hint = locale.config_management.visual.additions.codexEnableApplyPatch.hint;
+      expect(hint).toContain('freeform apply_patch');
+      expect(hint).not.toBe('');
+    }
+    expect(en.config_management.visual.additions.codexEnableApplyPatch.hint).toContain('When off');
+    expect(zh.config_management.visual.additions.codexEnableApplyPatch.hint).toContain(
+      '关闭时保留'
+    );
+  });
+});
