+/** One lightweight polling loop per visible page, shared by all credential badges. */
+export function AuthFileConcurrencyProvider({
+  children,
+  active = true,
+}: {
+  children: ReactNode;
+  active?: boolean;
+}) {
+  const apiBase = useAuthStore((state) => state.apiBase);
+  const managementKey = useAuthStore((state) => state.managementKey);
+  const connected = useAuthStore((state) => state.connectionStatus === 'connected');
+  const generation = useQuotaStore((state) => state.cacheGeneration);
+  const [snapshot, setSnapshot] = useState<{
+    apiBase: string;
+    managementKey: string;
+    generation: number;
+    value: ConcurrencySnapshot;
+  } | null>(null);
+
+  useEffect(() => {
+    if (!active || !connected) return;
+    let disposed = false;
+    let requestId = 0;
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    let controller: AbortController | undefined;
+    const isCurrentSession = () =>
+      useAuthStore.getState().apiBase === apiBase &&
+      useAuthStore.getState().managementKey === managementKey &&
+      useQuotaStore.getState().cacheGeneration === generation;
+    const poll = async () => {
+      if (disposed || document.hidden || !isCurrentSession()) return;
+      const id = ++requestId;
+      controller = new AbortController();
+      const current = () => !disposed && id === requestId && !document.hidden && isCurrentSession();
+      try {
+        const entries = await authFilesApi.concurrency(controller.signal);
+        if (!current()) return;
+        setSnapshot({
+          apiBase,
+          managementKey,
+          generation,
+          value: {
+            entries: new Map(entries.map((entry) => [concurrencyIdentity(entry), entry])),
+            failed: false,
+          },
+        });
+      } catch {
+        if (!current()) return;
+        setSnapshot((previous) => ({
+          apiBase,
+          managementKey,
+          generation,
+          value: {
+            entries:
+              previous?.apiBase === apiBase &&
+              previous.managementKey === managementKey &&
+              previous.generation === generation
+                ? previous.value.entries
+                : new Map(),
+            failed: true,
+          },
+        }));
+      } finally {
+        if (current()) timer = setTimeout(() => void poll(), 2000);
+      }
+    };
+    const onVisibility = () => {
+      requestId++;
+      clearTimeout(timer);
+      controller?.abort();
+      if (!document.hidden) void poll();
+    };
+    document.addEventListener('visibilitychange', onVisibility);
+    void poll();
+    return () => {
+      disposed = true;
+      requestId++;
+      clearTimeout(timer);
+      controller?.abort();
+      document.removeEventListener('visibilitychange', onVisibility);
+    };
+  }, [active, connected, apiBase, managementKey, generation]);
+
+  const current =
+    connected &&
+    snapshot?.apiBase === apiBase &&
+    snapshot.managementKey === managementKey &&
+    snapshot.generation === generation;
+  return (
+    <ConcurrencyContext.Provider value={current ? snapshot.value : null}>
+      {children}
+    </ConcurrencyContext.Provider>
+  );
+}
+
+export function AuthFileConcurrencyBadge({ file }: { file: AuthFileItem }) {
+  const { t } = useTranslation();
+  const { inFlight, limit, managed } = useAuthFileConcurrency(file);
+  const title = managed
+    ? t('auth_files.concurrency_managed_hint')
+    : inFlight === null || limit === null
+      ? t('auth_files.concurrency_unknown')
+      : t('auth_files.concurrency_usage', { count: inFlight, limit });
+  return (
+    <span
+      className={styles.badge}
+      title={title}
+      aria-label={title}
+      data-concurrency-name={file.name}
+    >
+      <IconNetwork size={12} aria-hidden="true" />
+      <span>
+        {managed ? '—' : (inFlight ?? '—')} / {managed ? 'Home' : (limit ?? '—')}
+      </span>
+    </span>
+  );
+}
