+
+  .credential {
+    grid-template-columns: minmax(0, 1fr) auto auto;
+  }
+
+  .identityHash,
+  .proxyMode {
+    grid-row: 2;
+  }
+
+  .rowActions {
+    grid-column: 3;
+    grid-row: 1 / span 2;
+  }
+}
+
+@include mobile {
+  .summary {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .credential {
+    grid-template-columns: minmax(0, 1fr) auto;
