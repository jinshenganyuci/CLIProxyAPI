+++ b/tests/providerConcurrencyPreservation.test.ts
@@ -0,0 +1,273 @@
+import { afterEach, describe, expect, test } from 'bun:test';
+import { apiClient } from '../src/services/api/client';
+import { providersApi } from '../src/services/api/providers';
+import {
+  normalizeApiKeyEntry,
+  normalizeGeminiKeyConfig,
+  normalizeOpenAIProvider,
+  normalizeProviderKeyConfig,
+} from '../src/services/api/transformers';
+import {
+  buildOpenAIConfig,
+  buildProviderKeyConfig,
+} from '../src/features/providers/useProviderWorkbench';
+import type { ProviderEntryFormInput } from '../src/features/providers/types';
+import type { OpenAIProviderConfig, ProviderKeyConfig } from '../src/types/provider';
+
+const originalGet = apiClient.get;
+const originalPut = apiClient.put;
+afterEach(() => {
+  apiClient.get = originalGet;
+  apiClient.put = originalPut;
+});
+
+const form = (patch: Partial<ProviderEntryFormInput> = {}): ProviderEntryFormInput => ({
+  apiKey: '',
+  name: 'example',
+  baseUrl: 'https://new.example/v1',
+  proxyUrl: 'socks5://new.example:1080',
+  prefix: '',
+  disabled: false,
+  models: [{ name: 'new-model', alias: 'new-alias' }],
+  headers: [],
+  excludedModelsText: '',
+  ...patch,
+});
+
+const captureWrites = (raw: Record<string, unknown>) => {
+  const writes: Array<{ path: string; value: unknown }> = [];
+  apiClient.get = (async () => raw) as typeof apiClient.get;
+  apiClient.put = (async (path: string, value?: unknown) => {
+    writes.push({ path, value });
+    return undefined;
+  }) as typeof apiClient.put;
+  return writes;
+};
+
+const brands = [
+  ['gemini', 'gemini-api-key', providersApi.createGeminiKey, providersApi.updateGeminiKey],
+  [
+    'interactions',
+    'interactions-api-key',
+    providersApi.createInteractionsKey,
+    providersApi.updateInteractionsKey,
+  ],
+  ['codex', 'codex-api-key', providersApi.createCodexConfig, providersApi.updateCodexConfig],
+  ['meta', 'meta-api-key', providersApi.createMetaConfig, providersApi.updateMetaConfig],
+  ['xai', 'xai-api-key', providersApi.createXAIConfig, providersApi.updateXAIConfig],
+  ['claude', 'claude-api-key', providersApi.createClaudeConfig, providersApi.updateClaudeConfig],
+  ['vertex', 'vertex-api-key', providersApi.createVertexConfig, providersApi.updateVertexConfig],
+] as const;
+
+describe('direct provider concurrency preservation', () => {
+  for (const [brand, section, create, update] of brands) {
+    test(`${brand}: editing a URL or model preserves the latest limit and other credentials`, async () => {
+      const first = {
+        'api-key': 'same-key',
+        'base-url': 'https://old.example/v1',
+        'proxy-url': 'socks5://first.example:1080',
+        'concurrency-limit': 2,
+        'future-field': 'first',
+      };
+      const second = {
+        ...first,
+        'proxy-url': 'socks5://second.example:1080',
+        'concurrency-limit': 3,
+        'future-field': 'second',
+      };
+      const normalize =
+        brand === 'gemini' || brand === 'interactions'
+          ? normalizeGeminiKeyConfig
+          : normalizeProviderKeyConfig;
+      const existing = normalize(second)!;
+      expect(existing.concurrencyLimit).toBe(3);
+      const next = buildProviderKeyConfig(brand, form(), existing);
+      expect(next.concurrencyLimit).toBe(3);
+      const latestSecond = { ...second, 'concurrency-limit': 7 };
+      const writes = captureWrites({ [section]: [first, latestSecond] });
+      await update(existing.apiKey, existing.baseUrl, next);
+      const written = writes[0]?.value as Record<string, unknown>[];
+      expect(writes[0]?.path).toBe(`/${section}`);
+      expect(written[0]).toEqual(first);
+      expect(written[1]?.['concurrency-limit']).toBe(7);
+      expect(written[1]?.['base-url']).toBe('https://new.example/v1');
+      expect(written[1]?.['proxy-url']).toBe('socks5://new.example:1080');
+      expect(written[1]?.models).toEqual([{ name: 'new-model', alias: 'new-alias' }]);
+      expect(written[1]?.['future-field']).toBe('second');
+      expect(JSON.stringify(written)).not.toContain('sourceIdentity');
+    });
+
+    test(`${brand}: a reset to the default is not undone by an old form`, async () => {
+      const raw = { 'api-key': 'key', 'base-url': 'https://old.example/v1' };
+      const existing = normalizeProviderKeyConfig({ ...raw, 'concurrency-limit': 3 })!;
+      const writes = captureWrites({ [section]: [raw] });
+      await update(
+        existing.apiKey,
+        existing.baseUrl,
+        buildProviderKeyConfig(brand, form(), existing)
+      );
+      expect((writes[0]?.value as Record<string, unknown>[])[0]).not.toHaveProperty(
+        'concurrency-limit'
+      );
+    });
+
+    test(`${brand}: creation serializes a configured limit and leaves an omitted default absent`, async () => {
+      const writes = captureWrites({ [section]: [] });
+      await create({ apiKey: 'configured-key', concurrencyLimit: 3 });
+      await create({ apiKey: 'default-key' });
+      expect((writes[0]?.value as Record<string, unknown>[])[0]?.['concurrency-limit']).toBe(3);
+      expect((writes[1]?.value as Record<string, unknown>[])[0]).not.toHaveProperty(
+        'concurrency-limit'
+      );
+    });
+  }
+
+  test('ambiguous direct credentials fail before PUT instead of modifying the first match', async () => {
+    const raw = { 'api-key': 'same-key', 'base-url': 'https://old.example/v1' };
+    const writes = captureWrites({ 'codex-api-key': [raw, raw] });
+    const existing = normalizeProviderKeyConfig(raw)!;
+    await expect(
+      providersApi.updateCodexConfig(
+        existing.apiKey,
+        existing.baseUrl,
+        buildProviderKeyConfig('codex', form(), existing) as ProviderKeyConfig
+      )
+    ).rejects.toThrow('configuration changed');
+    expect(writes).toEqual([]);
+  });
+});
+
+const compatibleRaw = () => ({
+  name: 'example',
+  'base-url': 'https://old.example/v1',
+  'concurrency-limit': 4,
+  'future-provider': 'preserved',
+  'api-key-entries': [
+    {
+      'api-key': 'same-key',
+      'proxy-url': 'socks5://first.example:1080',
+      'concurrency-limit': 3,
+      'future-entry': 'first',
+    },
+    {
+      'api-key': 'same-key',
+      'proxy-url': 'socks5://second.example:1080',
+      'concurrency-limit': 7,
+      'future-entry': 'second',
+    },
+  ],
+});
+
+const entryInput = (provider: OpenAIProviderConfig, index: number) => {
+  const entry = provider.apiKeyEntries[index]!;
+  return {
+    apiKey: '',
+    existingApiKey: entry.apiKey,
+    proxyUrl: entry.proxyUrl ?? '',
+    concurrencyLimit: entry.concurrencyLimit,
+    sourceIdentity: { apiKey: entry.apiKey, proxyUrl: entry.proxyUrl },
+  };
+};
+
+describe('OpenAI-compatible credential concurrency preservation', () => {
+  test('normalizes both per-key limits and the independent fallback limit', () => {
+    const existing = normalizeOpenAIProvider(compatibleRaw())!;
+    expect(existing.concurrencyLimit).toBe(4);
+    expect(existing.apiKeyEntries.map((entry) => entry.concurrencyLimit)).toEqual([3, 7]);
+    expect(normalizeApiKeyEntry({ 'api-key': 'default' })?.concurrencyLimit).toBeUndefined();
+  });
+
+  test('reordering duplicate keys and changing a proxy preserves the correct latest counters', async () => {
+    const raw = compatibleRaw();
+    const existing = normalizeOpenAIProvider(raw)!;
+    const next = buildOpenAIConfig(
+      form({
+        apiKeyEntries: [
+          { ...entryInput(existing, 1), proxyUrl: 'socks5://changed.example:1080' },
+          entryInput(existing, 0),
+        ],
+      }),
+      existing
+    );
+    expect(next.apiKeyEntries.map((entry) => entry.concurrencyLimit)).toEqual([7, 3]);
+    raw['api-key-entries'][1]!['concurrency-limit'] = 8;
+    raw['concurrency-limit'] = 9;
+    const writes = captureWrites({ 'openai-compatibility': [raw] });
+    await providersApi.updateOpenAIProvider(existing.name, 0, next);
+    const written = (writes[0]?.value as Record<string, unknown>[])[0]!;
+    expect(written['concurrency-limit']).toBe(9);
+    expect(written['api-key-entries']).toEqual([
+      {
+        'api-key': 'same-key',
+        'proxy-url': 'socks5://changed.example:1080',
+        'concurrency-limit': 8,
+        'future-entry': 'second',
+      },
+      raw['api-key-entries'][0],
+    ]);
+    expect(written['future-provider']).toBe('preserved');
+    expect(JSON.stringify(written)).not.toContain('sourceIdentity');
+  });
+
+  test('deleting one duplicate key and adding a new entry does not transfer its limit', async () => {
+    const raw = compatibleRaw();
+    const existing = normalizeOpenAIProvider(raw)!;
+    const next = buildOpenAIConfig(
+      form({ apiKeyEntries: [entryInput(existing, 1), { apiKey: 'new-key', proxyUrl: '' }] }),
+      existing
+    );
+    const writes = captureWrites({ 'openai-compatibility': [raw] });
+    await providersApi.updateOpenAIProvider(existing.name, 0, next);
+    const entries = (writes[0]?.value as Record<string, unknown>[])[0]?.[
+      'api-key-entries'
+    ] as Record<string, unknown>[];
+    expect(entries).toEqual([raw['api-key-entries'][1], { 'api-key': 'new-key' }]);
+  });
+
+  test('a removed entry cannot be recreated from a stale editor snapshot', async () => {
+    const raw = compatibleRaw();
+    const existing = normalizeOpenAIProvider(raw)!;
+    const next = buildOpenAIConfig(form({ apiKeyEntries: [entryInput(existing, 1)] }), existing);
+    raw['api-key-entries'] = [raw['api-key-entries'][0]!];
+    const writes = captureWrites({ 'openai-compatibility': [raw] });
+    await expect(providersApi.updateOpenAIProvider(existing.name, 0, next)).rejects.toThrow(
+      'configuration changed'
+    );
+    expect(writes).toEqual([]);
+  });
+
+  for (const latestLimit of [5, undefined]) {
+    test(`fallback credential preserves latest ${latestLimit ?? 'implicit default'} on save`, async () => {
+      const raw: Record<string, unknown> = {
+        name: 'fallback',
+        'base-url': 'https://old.example/v1',
+        'api-key-entries': [],
+        ...(latestLimit === undefined ? {} : { 'concurrency-limit': latestLimit }),
+      };
+      const existing = normalizeOpenAIProvider({ ...raw, 'concurrency-limit': 3 })!;
+      const next = buildOpenAIConfig(form({ name: 'fallback', apiKeyEntries: [] }), existing);
+      const writes = captureWrites({ 'openai-compatibility': [raw] });
+      await providersApi.updateOpenAIProvider(existing.name, 0, next);
+      const written = (writes[0]?.value as Record<string, unknown>[])[0]!;
+      expect(written['concurrency-limit']).toBe(latestLimit);
+      expect(written['api-key-entries']).toEqual([]);
+      expect(written['base-url']).toBe('https://new.example/v1');
+    });
+  }
+
+  test('creation serializes independent entry and fallback limits without inventing a default', async () => {
+    const writes = captureWrites({ 'openai-compatibility': [] });
+    await providersApi.createOpenAIProvider({
+      name: 'new',
+      baseUrl: 'https://new.example/v1',
+      concurrencyLimit: 4,
+      apiKeyEntries: [{ apiKey: 'configured', concurrencyLimit: 3 }, { apiKey: 'default' }],
+    });
+    const written = (writes[0]?.value as Record<string, unknown>[])[0]!;
+    expect(written['concurrency-limit']).toBe(4);
+    expect(written['api-key-entries']).toEqual([
+      { 'api-key': 'configured', 'concurrency-limit': 3 },
+      { 'api-key': 'default' },
+    ]);
+  });
+});
