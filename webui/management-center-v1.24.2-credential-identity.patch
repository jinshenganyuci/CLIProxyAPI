diff --git a/tests/modelDiscoveryCredentialProxy.test.ts b/tests/modelDiscoveryCredentialProxy.test.ts
new file mode 100644
index 0000000..d52914f
--- /dev/null
+++ b/tests/modelDiscoveryCredentialProxy.test.ts
@@ -0,0 +1,68 @@
+import { afterEach, describe, expect, spyOn, test } from 'bun:test';
+import { createElement } from 'react';
+import { renderToStaticMarkup } from 'react-dom/server';
+import { modelsApi } from '@/services/api';
+import {
+  useModelDiscovery,
+  type UseModelDiscoveryArgs,
+  type UseModelDiscoveryResult,
+} from '@/features/providers/sheets/forms/useModelDiscovery';
+
+const fetchFromHook = (overrides: Partial<UseModelDiscoveryArgs>) => {
+  let discovery: UseModelDiscoveryResult | undefined;
+  const Capture = () => {
+    discovery = useModelDiscovery({
+      brand: 'openaiCompatibility',
+      baseUrl: 'https://models.example.invalid/v1',
+      formHeaders: [{ key: 'X-Route-Test', value: 'fixture' }],
+      apiKeyEntries: [{ apiKey: 'synthetic-key' }],
+      ...overrides,
+    });
+    return null;
+  };
+  renderToStaticMarkup(createElement(Capture));
+  if (!discovery) throw new Error('Hook did not render');
+  return discovery.fetch;
+};
+
+let restore: (() => void) | undefined;
+afterEach(() => { restore?.(); restore = undefined; });
+
+describe('model discovery preserves selected credential routing', () => {
+  for (const selection of ['provider', 'entry'] as const) {
+    test(`${selection} proxy failure cannot trigger an unbound request`, async () => {
+      const request = spyOn(modelsApi, 'fetchModelsViaApiCall')
+        .mockRejectedValueOnce(new Error('Selected credential proxy failed'))
+        .mockResolvedValue([{ id: 'unbound-model', name: 'unbound-model' }]);
+      restore = () => request.mockRestore();
+      const fetch = fetchFromHook({
+        authIndex: selection === 'provider' ? 'provider-index' : 'ignored-provider-index',
+        apiKeyEntries: [{ apiKey: 'synthetic-key', ...(selection === 'entry' ? { authIndex: 'entry-index' } : {}) }],
+      });
+      await fetch();
+      expect(request).toHaveBeenCalledTimes(1);
+      expect(request).toHaveBeenCalledWith(
+        'https://models.example.invalid/v1', 'synthetic-key',
+        { 'X-Route-Test': 'fixture' }, `${selection}-index`,
+      );
+    });
+  }
+
+  test('unbound discovery retains one anonymous fallback for public model lists', async () => {
+    const request = spyOn(modelsApi, 'fetchModelsViaApiCall')
+      .mockRejectedValueOnce(new Error('Discovery does not accept this key'))
+      .mockResolvedValue([]);
+    restore = () => request.mockRestore();
+    await fetchFromHook({})();
+    expect(request).toHaveBeenCalledTimes(2);
+    expect(request).toHaveBeenLastCalledWith('https://models.example.invalid/v1');
+  });
+
+  test('successful selected discovery sends the credential index once', async () => {
+    const request = spyOn(modelsApi, 'fetchModelsViaApiCall').mockResolvedValue([]);
+    restore = () => request.mockRestore();
+    await fetchFromHook({ authIndex: 'selected-index' })();
+    expect(request).toHaveBeenCalledTimes(1);
+    expect(request.mock.calls[0]?.[3]).toBe('selected-index');
+  });
+});
