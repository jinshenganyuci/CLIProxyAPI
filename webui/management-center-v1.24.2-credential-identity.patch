+import en from '@/i18n/locales/en.json';
+import zhCN from '@/i18n/locales/zh-CN.json';
+import zhTW from '@/i18n/locales/zh-TW.json';
+import ru from '@/i18n/locales/ru.json';
+
+afterEach(() => mock.restore());
+
+for (const provider of ['kimi', 'kimi-ai'] as const) {
+  describe(`${provider} credential login`, () => {
+    test('uses its own endpoint and normalizes device code and expiry', async () => {
+      const post = spyOn(apiClient, 'post').mockResolvedValue({
+        url: 'https://device.example.invalid',
+        state: `${provider}-fixture`,
+        user_code: ' DEVICE-CODE ',
+        expires_in: 600,
+        flow: 'device',
+      });
+      const result = await oauthApi.startAuth(provider, undefined, { proxyURL: 'direct' });
+      expect(post).toHaveBeenCalledWith(
+        `/${provider}-auth-url`,
+        { is_webui: true, proxy_url: 'direct' },
+        undefined
+      );
+      expect(result).toEqual({
+        url: 'https://device.example.invalid',
+        state: `${provider}-fixture`,
+        userCode: 'DEVICE-CODE',
+        expiresIn: 600,
+        flow: 'device',
+      });
+    });
+    test('does not invent a code or expiry when the backend omits them', async () => {
+      spyOn(apiClient, 'post').mockResolvedValue({
+        url: 'https://device.example.invalid',
+        state: `${provider}-fixture`,
+      });
+      const result = await oauthApi.startAuth(provider);
+      expect(result.userCode).toBeUndefined();
+      expect(result.expiresIn).toBeUndefined();
+    });
+  });
+}
+
+test('both Kimi domains retain independent proxy cards and complete translations', async () => {
+  const suffixes = [
+    'oauth_title',
+    'oauth_button',
+    'oauth_hint',
+    'oauth_url_label',
+    'open_link',
+    'copy_link',
+    'oauth_status_waiting',
+    'oauth_status_success',
+    'oauth_status_error',
+    'oauth_start_error',
+    'oauth_polling_error',
+    'proxy_label',
+    'proxy_global',
+    'proxy_custom',
+    'proxy_direct',
+    'proxy_url_label',
+    'proxy_required',
+    'proxy_hint',
+    'proxy_global_hint',
+    'oauth_cancel',
+    'oauth_cancelled',
+    'oauth_cancel_error',
+    'oauth_retry_hint',
+    'user_code_label',
+    'copy_code',
+    'code_copied',
+    'expiry_hint',
+  ];
+  for (const [language, locale] of Object.entries({ en, 'zh-CN': zhCN, 'zh-TW': zhTW, ru })) {
+    const i18n = createInstance();
+    await i18n.init({ lng: language, resources: { [language]: { translation: locale } } });
+    const html = renderToStaticMarkup(
+      createElement(
+        I18nextProvider,
+        { i18n },
+        createElement(MemoryRouter, null, createElement(OAuthPage))
+      )
+    );
+    for (const provider of ['kimi', 'kimi-ai', 'codex', 'devin', 'meta']) {
+      expect(html.match(new RegExp(`id="${provider}-oauth-proxy-mode"`, 'g'))).toHaveLength(1);
+    }
+    for (const prefix of ['kimi_', 'kimi_ai_']) {
+      for (const suffix of suffixes)
+        expect((locale.auth_login as Record<string, string>)[prefix + suffix]?.trim()).toBeTruthy();
+    }
+    expect(html).toContain(locale.auth_login.kimi_oauth_title);
+    expect(html).toContain(locale.auth_login.kimi_ai_oauth_title);
+    expect(html).not.toContain('auth_login.kimi_');
+  }
+});
