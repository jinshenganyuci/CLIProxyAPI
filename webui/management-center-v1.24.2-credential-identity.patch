+}
+
+.headerActions,
+.rowActions {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.summary {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 8px;
+}
+
+.metric {
+  display: flex;
+  align-items: baseline;
+  gap: 8px;
+  min-width: 0;
+  padding: 10px 12px;
+  border: 1px solid color-mix(in srgb, var(--border-color) 75%, transparent);
+  border-radius: 10px;
+  background: color-mix(in srgb, var(--bg-secondary) 58%, transparent);
+
+  strong {
+    color: var(--text-primary);
+    font-family: $font-mono;
+    font-size: 18px;
+  }
+
+  span {
+    color: var(--text-tertiary);
+    font-size: 11.5px;
+  }
+}
+
+.ok strong {
+  color: var(--success-color);
+}
+
+.warn strong {
+  color: var(--warning-color);
+}
+
+.danger strong {
+  color: var(--danger-color);
+}
+
+.settings {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 10px;
+}
+
+.setting {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  min-width: 0;
+  padding: 12px;
+  border: 1px solid color-mix(in srgb, var(--border-color) 72%, transparent);
+  border-radius: 12px;
+  background: color-mix(in srgb, var(--bg-secondary) 42%, transparent);
+
+  > div:first-child {
+    display: flex;
+    flex-direction: column;
+    gap: 3px;
+    min-width: 0;
+  }
+
+  strong {
+    color: var(--text-primary);
+    font-size: 12.5px;
+  }
+
+  span {
+    color: var(--text-tertiary);
+    font-size: 11.5px;
+    line-height: 1.45;
+  }
+}
+
+.credentials {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+
+.credential {
+  display: grid;
+  grid-template-columns: minmax(190px, 1.4fr) auto minmax(120px, 0.7fr) minmax(90px, 0.5fr) auto;
+  align-items: center;
+  gap: 12px;
+  padding: 10px 12px;
+  border: 1px solid color-mix(in srgb, var(--border-color) 68%, transparent);
+  border-radius: 10px;
+  background: color-mix(in srgb, var(--bg-secondary) 34%, transparent);
+}
+
+.credentialName,
+.identityHash,
+.proxyMode {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  min-width: 0;
+
+  > span {
+    color: var(--text-tertiary);
+    font-size: 10.5px;
+  }
+}
+
+.credentialName strong {
+  color: var(--text-primary);
+  font-family: $font-mono;
+  font-size: 12px;
+  @include text-ellipsis;
+}
+
+.credentialName span {
+  @include text-ellipsis;
+}
+
+.identityHash code,
+.proxyMode strong {
+  color: var(--text-secondary);
+  font-family: $font-mono;
+  font-size: 11.5px;
+}
+
+.status {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  padding: 3px 7px;
+  border-radius: 999px;
+  font-size: 10.5px;
+  font-weight: 650;
+  white-space: nowrap;
+}
+
+.status_ready {
