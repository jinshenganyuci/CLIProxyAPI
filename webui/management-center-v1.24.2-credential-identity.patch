diff --git a/src/services/api/authFileConcurrency.ts b/src/services/api/authFileConcurrency.ts
new file mode 100644
index 0000000..3262486
--- /dev/null
+++ b/src/services/api/authFileConcurrency.ts
@@ -0,0 +1,75 @@
+import type { AuthFileItem } from '@/types';
+
+export const DEFAULT_CREDENTIAL_CONCURRENCY = 10;
+export const MAX_CREDENTIAL_CONCURRENCY = 1_000_000;
+
+export type AuthFileConcurrency = {
+  limit: number | null;
+  inFlight: number | null;
+  managed: boolean;
+};
+
+export type AuthFileConcurrencyEntry = AuthFileConcurrency & {
+  id: string;
+  name: string;
+  authIndex: string;
+};
+
+const integer = (value: unknown, min: number, max = Number.MAX_SAFE_INTEGER): number | null =>
+  typeof value === 'number' && Number.isSafeInteger(value) && value >= min && value <= max
+    ? value
+    : null;
+
+export const normalizeAuthFileConcurrency = (
+  value: Record<string, unknown>
+): AuthFileConcurrency => {
+  const managed = value.concurrency_managed === true;
+  return {
+    managed,
+    limit: managed ? null : integer(value.concurrency_limit, 1, MAX_CREDENTIAL_CONCURRENCY),
+    inFlight: managed ? null : integer(value.concurrency_in_flight, 0),
+  };
+};
+
+export const normalizeConcurrencyEntries = (value: unknown): AuthFileConcurrencyEntry[] => {
+  if (
+    !value ||
+    typeof value !== 'object' ||
+    !('entries' in value) ||
+    !Array.isArray(value.entries)
+  ) {
+    throw new Error('Invalid credential concurrency snapshot');
+  }
+  return value.entries.flatMap((item: unknown) => {
+    if (!item || typeof item !== 'object' || Array.isArray(item)) return [];
+    const record = item as Record<string, unknown>;
+    const text = (v: unknown) => (typeof v === 'string' || typeof v === 'number' ? String(v) : '');
+    return [
+      {
+        ...normalizeAuthFileConcurrency(record),
+        id: text(record.id),
+        name: text(record.name),
+        authIndex: text(record.auth_index),
+      },
+    ];
+  });
+};
+
+export const concurrencyIdentity = (
+  file: Pick<AuthFileItem, 'name' | 'authIndex'> & { id?: unknown }
+): string => {
+  if (file.authIndex !== undefined && file.authIndex !== null && String(file.authIndex) !== '') {
+    return `index:${file.authIndex}`;
+  }
+  if (typeof file.id === 'string' && file.id) return `id:${file.id}`;
+  return `name:${file.name}`;
+};
+
+export const parseConcurrencyLimit = (text: string): number | null => {
+  const trimmed = text.trim();
+  if (!trimmed) return null;
+  if (!/^[0-9]+$/.test(trimmed)) throw new Error('auth_files.concurrency_invalid');
+  const value = integer(Number(trimmed), 1, MAX_CREDENTIAL_CONCURRENCY);
+  if (value === null) throw new Error('auth_files.concurrency_invalid');
+  return value;
+};
