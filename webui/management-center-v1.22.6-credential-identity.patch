@@ -0,0 +1,278 @@
+@use '../../../styles/mixins' as *;
+
+.panel {
+  display: flex;
+  flex-direction: column;
+  gap: 16px;
+  padding: clamp(16px, 2vw, 22px);
+  border: 1px solid var(--border-color);
+  border-radius: 16px;
+  background: color-mix(in srgb, var(--bg-primary) 86%, transparent);
+}
+
+.header {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 16px;
+  flex-wrap: wrap;
+}
+
+.title {
+  margin: 0;
+  color: var(--text-primary);
+  font-size: 16px;
+  font-weight: 680;
+  letter-spacing: -0.015em;
+}
+
+.description {
+  max-width: 880px;
+  margin: 5px 0 0;
+  color: var(--text-secondary);
+  font-size: 12.5px;
+  line-height: 1.55;
+}
+
+.headerActions,
+.rowActions {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.summary {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 8px;
+}
+
+.metric {
+  display: flex;
+  align-items: baseline;
+  gap: 8px;
+  min-width: 0;
+  padding: 10px 12px;
+  border: 1px solid color-mix(in srgb, var(--border-color) 75%, transparent);
+  border-radius: 10px;
+  background: color-mix(in srgb, var(--bg-secondary) 58%, transparent);
+
+  strong {
+    color: var(--text-primary);
+    font-family: $font-mono;
+    font-size: 18px;
+  }
+
+  span {
+    color: var(--text-tertiary);
+    font-size: 11.5px;
+  }
+}
+
+.ok strong {
+  color: var(--success-color);
+}
+
+.warn strong {
+  color: var(--warning-color);
+}
+
+.danger strong {
+  color: var(--danger-color);
+}
+
+.settings {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 10px;
+}
+
+.setting {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  min-width: 0;
+  padding: 12px;
+  border: 1px solid color-mix(in srgb, var(--border-color) 72%, transparent);
+  border-radius: 12px;
+  background: color-mix(in srgb, var(--bg-secondary) 42%, transparent);
+
+  > div:first-child {
+    display: flex;
+    flex-direction: column;
+    gap: 3px;
+    min-width: 0;
+  }
+
+  strong {
+    color: var(--text-primary);
+    font-size: 12.5px;
+  }
+
+  span {
+    color: var(--text-tertiary);
+    font-size: 11.5px;
+    line-height: 1.45;
+  }
+}
+
+.credentials {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+
+.credential {
+  display: grid;
+  grid-template-columns: minmax(190px, 1.4fr) auto minmax(120px, 0.7fr) minmax(90px, 0.5fr) auto;
+  align-items: center;
+  gap: 12px;
+  padding: 10px 12px;
+  border: 1px solid color-mix(in srgb, var(--border-color) 68%, transparent);
+  border-radius: 10px;
+  background: color-mix(in srgb, var(--bg-secondary) 34%, transparent);
+}
+
+.credentialName,
+.identityHash,
+.proxyMode {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  min-width: 0;
+
+  > span {
+    color: var(--text-tertiary);
+    font-size: 10.5px;
+  }
+}
+
+.credentialName strong {
+  color: var(--text-primary);
+  font-family: $font-mono;
+  font-size: 12px;
+  @include text-ellipsis;
+}
+
+.credentialName span {
+  @include text-ellipsis;
+}
+
+.identityHash code,
+.proxyMode strong {
+  color: var(--text-secondary);
+  font-family: $font-mono;
+  font-size: 11.5px;
+}
+
+.status {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  padding: 3px 7px;
+  border-radius: 999px;
+  font-size: 10.5px;
+  font-weight: 650;
+  white-space: nowrap;
+}
+
+.status_ready {
+  color: var(--success-color);
+  background: color-mix(in srgb, var(--success-color) 12%, transparent);
+}
+
+.status_missing {
+  color: var(--warning-color);
+  background: color-mix(in srgb, var(--warning-color) 12%, transparent);
+}
+
+.status_invalid,
+.status_conflict {
+  color: var(--danger-color);
+  background: color-mix(in srgb, var(--danger-color) 12%, transparent);
+}
+
+.rowMessage {
+  grid-column: 1 / -1;
+  color: var(--danger-color);
+  font-size: 11px;
+  overflow-wrap: anywhere;
+}
+
+.error,
+.loading,
+.empty {
+  padding: 12px;
+  border-radius: 10px;
+  color: var(--text-secondary);
+  background: color-mix(in srgb, var(--bg-secondary) 55%, transparent);
+  font-size: 12.5px;
+}
+
+.error {
+  color: var(--danger-color);
+  border: 1px solid var(--warning-border);
+}
+
+.panel :global(.btn) {
+  transition:
+    transform var(--dur-press, 160ms) var(--ease-out-strong, ease-out),
+    background-color $transition-fast,
+    border-color $transition-fast;
+}
+
+.panel :global(.btn:active:not(:disabled)) {
+  transform: scale(0.96);
+}
+
+@media (max-width: 1000px) {
+  .settings {
+    grid-template-columns: 1fr;
+  }
+
+  .credential {
+    grid-template-columns: minmax(0, 1fr) auto auto;
+  }
+
+  .identityHash,
+  .proxyMode {
+    grid-row: 2;
+  }
+
+  .rowActions {
+    grid-column: 3;
+    grid-row: 1 / span 2;
+  }
+}
+
+@include mobile {
+  .summary {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .credential {
+    grid-template-columns: minmax(0, 1fr) auto;
+  }
+
+  .credentialName {
+    grid-column: 1 / -1;
+  }
+
+  .identityHash,
+  .proxyMode,
+  .rowActions {
+    grid-column: auto;
+    grid-row: auto;
+  }
+
+  .rowActions {
+    justify-self: end;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .panel :global(.btn) {
+    transition: none;
+  }
+}
diff --git a/src/features/authFiles/components/CodexCredentialIdentityCard.tsx b/src/features/authFiles/components/CodexCredentialIdentityCard.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..5c5b12686db44187da71711ba670bd75e02789fe
--- /dev/null
+++ b/src/features/authFiles/components/CodexCredentialIdentityCard.tsx
@@ -0,0 +1,346 @@
+import { useCallback, useEffect, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { Button } from '@/components/ui/Button';
+import { ToggleSwitch } from '@/components/ui/ToggleSwitch';
+import {
+  codexCredentialIdentityApi,
+  type CodexCredentialIdentityCredential,
+  type CodexCredentialIdentityStatus,
+} from '@/services/api/codexCredentialIdentity';
+import { useNotificationStore } from '@/stores';
+import styles from './CodexCredentialIdentityCard.module.scss';
+
+type CodexCredentialIdentityCardProps = {
+  disableControls: boolean;
+  refreshKey: string;
+  onCredentialsChanged: () => void | Promise<void>;
+};
+
+const errorMessage = (error: unknown): string =>
+  error instanceof Error ? error.message : String(error || 'Unknown error');
+
+export function CodexCredentialIdentityCard({
+  disableControls,
+  refreshKey,
+  onCredentialsChanged,
+}: CodexCredentialIdentityCardProps) {
+  const { t } = useTranslation();
+  const { showNotification, showConfirmation } = useNotificationStore();
+  const [status, setStatus] = useState<CodexCredentialIdentityStatus | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState('');
+  const [action, setAction] = useState('');
+
+  const loadStatus = useCallback(async () => {
+    try {
+      setError('');
+      const next = await codexCredentialIdentityApi.getStatus();
+      setStatus(next);
+    } catch (loadError) {
+      setError(errorMessage(loadError));
+    } finally {
+      setLoading(false);
+    }
+  }, []);
+
+  useEffect(() => {
+    if (disableControls) return;
+    void loadStatus();
+  }, [disableControls, loadStatus, refreshKey]);
+
+  const updateConfig = useCallback(
+    async (
+      patch: Parameters<typeof codexCredentialIdentityApi.update>[0],
+      actionName: string,
+      successKey: string
+    ) => {
+      setAction(actionName);
+      try {
+        await codexCredentialIdentityApi.update(patch);
+        await loadStatus();
+        showNotification(t(successKey), 'success');
+      } catch (updateError) {
+        showNotification(
+          t('codex_credential_identity.action_failed', { message: errorMessage(updateError) }),
+          'error'
+        );
+      } finally {
+        setAction('');
+      }
+    },
+    [loadStatus, showNotification, t]
+  );
+
+  const initialize = useCallback(() => {
+    showConfirmation({
+      title: t('codex_credential_identity.initialize_title'),
+      message: t('codex_credential_identity.initialize_confirm', {
+        count: status?.missing ?? 0,
+      }),
+      confirmText: t('codex_credential_identity.initialize'),
+      onConfirm: async () => {
+        setAction('initialize');
+        try {
+          const result = await codexCredentialIdentityApi.initialize();
+          setStatus(result.identity);
+          await onCredentialsChanged();
+          showNotification(
+            t('codex_credential_identity.initialize_success', {
+              count: result.initialized,
+            }),
+            'success'
+          );
+        } catch (initializeError) {
+          showNotification(
+            t('codex_credential_identity.action_failed', {
+              message: errorMessage(initializeError),
+            }),
+            'error'
+          );
+        } finally {
+          setAction('');
+        }
+      },
+    });
+  }, [onCredentialsChanged, showConfirmation, showNotification, status?.missing, t]);
+
+  const rotate = useCallback(
+    (credential: CodexCredentialIdentityCredential) => {
+      showConfirmation({
+        title: t('codex_credential_identity.rotate_title'),
+        message: t('codex_credential_identity.rotate_confirm', { name: credential.name }),
+        confirmText: t('codex_credential_identity.rotate'),
+        variant: 'danger',
+        onConfirm: async () => {
+          setAction(`rotate:${credential.auth_index || credential.name}`);
+          try {
+            await codexCredentialIdentityApi.rotate(credential.name, credential.auth_index);
+            await Promise.all([loadStatus(), Promise.resolve(onCredentialsChanged())]);
+            showNotification(
+              t('codex_credential_identity.rotate_success', { name: credential.name }),
+              'success'
+            );
+          } catch (rotateError) {
+            showNotification(
+              t('codex_credential_identity.action_failed', {
+                message: errorMessage(rotateError),
+              }),
+              'error'
+            );
+          } finally {
+            setAction('');
+          }
+        },
+      });
+    },
+    [loadStatus, onCredentialsChanged, showConfirmation, showNotification, t]
+  );
+
+  const controlsDisabled = disableControls || loading || Boolean(action);
+  const initializeDisabled =
+    controlsDisabled ||
+    !status ||
+    status.missing === 0 ||
+    status.invalid > 0 ||
+    status.conflicts > 0 ||
+    status.unsupported > 0;
+
+  return (
+    <section className={styles.panel} aria-labelledby="codex-credential-identity-title">
+      <header className={styles.header}>
+        <div>
+          <h3 id="codex-credential-identity-title" className={styles.title}>
+            {t('codex_credential_identity.title')}
+          </h3>
+          <p className={styles.description}>{t('codex_credential_identity.description')}</p>
+        </div>
+        <div className={styles.headerActions}>
+          <Button
+            variant="secondary"
+            size="sm"
+            onClick={() => void loadStatus()}
+            disabled={controlsDisabled}
+          >
+            {t('common.refresh')}
+          </Button>
+          <Button
+            size="sm"
+            onClick={initialize}
+            disabled={initializeDisabled}
+            loading={action === 'initialize'}
+          >
+            {t('codex_credential_identity.initialize')}
+          </Button>
+        </div>
+      </header>
+
+      {error ? (
+        <div className={styles.error} role="alert">
+          {t('codex_credential_identity.load_failed', { message: error })}
+        </div>
+      ) : loading || !status ? (
+        <div className={styles.loading}>{t('common.loading')}</div>
+      ) : (
+        <>
+          <div className={styles.summary} aria-live="polite">
+            <SummaryMetric label={t('codex_credential_identity.total')} value={status.total} />
+            <SummaryMetric label={t('codex_credential_identity.ready')} value={status.ready} tone="ok" />
+            <SummaryMetric
+              label={t('codex_credential_identity.missing')}
+              value={status.missing}
+              tone={status.missing > 0 ? 'warn' : undefined}
+            />
+            <SummaryMetric
+              label={t('codex_credential_identity.problems')}
+              value={status.invalid + status.conflicts + status.unsupported}
+              tone={status.invalid + status.conflicts + status.unsupported > 0 ? 'danger' : undefined}
+            />
+          </div>
+
+          <div className={styles.settings}>
+            <SettingRow
+              title={t('codex_credential_identity.enable_title')}
+              description={
+                status.legacy_identity_confuse
+                  ? t('codex_credential_identity.legacy_conflict')
+                  : t('codex_credential_identity.enable_desc')
+              }
+              checked={status.enabled}
+              disabled={
+                controlsDisabled ||
+                status.legacy_identity_confuse ||
+                (!status.enabled && !status.all_ready)
+              }
+              onChange={(enabled) =>
+                void updateConfig(
+                  { enabled },
+                  'enabled',
+                  enabled
+                    ? 'codex_credential_identity.enabled_success'
+                    : 'codex_credential_identity.disabled_success'
+                )
+              }
+            />
+            <SettingRow
+              title={t('codex_credential_identity.strict_proxy_title')}
+              description={t('codex_credential_identity.strict_proxy_desc', {
+                count: status.proxy_missing,
+              })}
+              checked={status.credential_proxy_policy === 'require'}
+              disabled={controlsDisabled}
+              onChange={(required) =>
+                void updateConfig(
+                  { credential_proxy_policy: required ? 'require' : 'prefer' },
+                  'proxy-policy',
+                  'codex_credential_identity.proxy_policy_success'
+                )
+              }
+            />
+            <SettingRow
+              title={t('codex_credential_identity.synthesize_title')}
+              description={t('codex_credential_identity.synthesize_desc')}
+              checked={status.synthesize_missing_installation_id}
+              disabled={controlsDisabled}
+              onChange={(enabled) =>
+                void updateConfig(
+                  { synthesize_missing_installation_id: enabled },
+                  'synthesize',
+                  'codex_credential_identity.synthesize_success'
+                )
+              }
+            />
+          </div>
+
+          {status.credentials.length === 0 ? (
+            <div className={styles.empty}>{t('codex_credential_identity.empty')}</div>
+          ) : (
+            <div className={styles.credentials}>
+              {status.credentials.map((credential) => {
+                const rowKey = credential.auth_index || credential.name;
+                return (
+                  <div className={styles.credential} key={rowKey}>
+                    <div className={styles.credentialName}>
+                      <strong>{credential.name}</strong>
+                      {credential.email && <span>{credential.email}</span>}
+                    </div>
+                    <StatusBadge status={credential.status} />
+                    <div className={styles.identityHash}>
+                      <span>{t('codex_credential_identity.identity_hash')}</span>
+                      <code>{credential.identity_hash || '—'}</code>
+                    </div>
+                    <div className={styles.proxyMode}>
+                      <span>{t('codex_credential_identity.proxy')}</span>
+                      <strong>{t(`codex_credential_identity.proxy_${credential.proxy_mode}`)}</strong>
+                    </div>
+                    <div className={styles.rowActions}>
+                      <Button
+                        variant="danger"
+                        size="sm"
+                        disabled={controlsDisabled || credential.status !== 'ready'}
+                        loading={action === `rotate:${rowKey}`}
+                        onClick={() => rotate(credential)}
+                      >
+                        {t('codex_credential_identity.rotate')}
+                      </Button>
+                    </div>
+                    {credential.message && <div className={styles.rowMessage}>{credential.message}</div>}
+                  </div>
+                );
+              })}
+            </div>
+          )}
+        </>
+      )}
+    </section>
+  );
+}
+
+function SummaryMetric({
+  label,
+  value,
+  tone,
+}: {
+  label: string;
+  value: number;
+  tone?: 'ok' | 'warn' | 'danger';
+}) {
+  return (
+    <div className={[styles.metric, tone ? styles[tone] : ''].filter(Boolean).join(' ')}>
+      <strong>{value}</strong>
+      <span>{label}</span>
+    </div>
+  );
+}
+
+function SettingRow({
+  title,
+  description,
+  checked,
+  disabled,
+  onChange,
+}: {
+  title: string;
+  description: string;
+  checked: boolean;
+  disabled: boolean;
+  onChange: (checked: boolean) => void;
+}) {
+  return (
+    <div className={styles.setting}>
+      <div>
+        <strong>{title}</strong>
+        <span>{description}</span>
+      </div>
+      <ToggleSwitch checked={checked} disabled={disabled} onChange={onChange} ariaLabel={title} />
+    </div>
+  );
+}
+
+function StatusBadge({ status }: { status: CodexCredentialIdentityCredential['status'] }) {
+  const { t } = useTranslation();
+  return (
+    <span className={[styles.status, styles[`status_${status}`]].join(' ')}>
+      {t(`codex_credential_identity.status_${status}`)}
+    </span>
+  );
+}
