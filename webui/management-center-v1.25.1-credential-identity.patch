new file mode 100644
index 0000000..51e4636
--- /dev/null
+++ b/src/features/authFiles/hooks/useAuthFileConcurrency.ts
@@ -0,0 +1,15 @@
+import { createContext, useContext } from 'react';
+import { concurrencyIdentity, type AuthFileConcurrency } from '@/services/api/authFileConcurrency';
+import type { AuthFileItem } from '@/types';
+
+export type ConcurrencySnapshot = { entries: Map<string, AuthFileConcurrency>; failed: boolean };
+export const ConcurrencyContext = createContext<ConcurrencySnapshot | null>(null);
+
+export function useAuthFileConcurrency(file: AuthFileItem): AuthFileConcurrency {
+  const snapshot = useContext(ConcurrencyContext);
+  const initial = file.concurrency ?? { limit: null, inFlight: null, managed: false };
+  const live = snapshot?.entries.get(concurrencyIdentity(file));
+  const value = live ?? initial;
+  if (snapshot && (snapshot.failed || !live)) return { ...value, inFlight: null };
+  return value;
+}
