diff --git a/tests/forkV1251Policies.test.ts b/tests/forkV1251Policies.test.ts
new file mode 100644
index 0000000..b23fa3d
--- /dev/null
+++ b/tests/forkV1251Policies.test.ts
@@ -0,0 +1,140 @@
+import { afterEach, describe, expect, test } from 'bun:test';
+import { apiClient } from '@/services/api/client';
+import { providersApi } from '@/services/api/providers';
+import { normalizeProviderGroups } from '@/services/api/transformers';
+import { buildRuntimePolicy, readRuntimePolicy } from '@/features/providers/runtimePolicy';
+import { readCredentialPolicy } from '@/features/authFiles/credentialPolicy';
+import {
+  buildAuthFileFieldsPatch,
+  type PrefixProxyEditorState,
+} from '@/features/authFiles/hooks/useAuthFilesPrefixProxyEditor';
+
+const originalGet = apiClient.get;
+const originalPut = apiClient.put;
+afterEach(() => {
+  apiClient.get = originalGet;
+  apiClient.put = originalPut;
+});
+
+const editor = (): PrefixProxyEditorState => {
+  const json = {
+    type: 'codex',
+    access_token: 'synthetic-token',
+    proxy_url: 'direct',
+    concurrency_limit: 3,
+    codex_namespace: 'synthetic-identity',
+    request_retry: 4,
+    model_aliases: [{ name: 'native-model', alias: 'public-model', 'force-mapping': false }],
+  };
+  return {
+    fileName: 'synthetic.json',
+    authIndex: 'synthetic-index',
+    fileInfoText: '',
+    loading: false,
+    saving: false,
+    error: null,
+    originalText: JSON.stringify(json),
+    rawText: JSON.stringify(json),
+    invalidContentPreview: '',
+    json,
+    providerKey: 'codex',
+    prefix: '',
+    proxyUrl: 'direct',
+    priority: '',
+    weight: '',
+    weightError: null,
+    concurrencyLimit: '2',
+    concurrencyTouched: true,
+    concurrencyError: null,
+    disableCooling: false,
+    disableCoolingTouched: false,
+    websockets: false,
+    websocketsTouched: false,
+    usingApi: false,
+    usingApiTouched: false,
+    note: '',
+    noteTouched: false,
+    excludedModelsText: '',
+    excludedModelsTouched: false,
+    headersText: '',
+    headersTouched: false,
+    headersError: null,
+    policy: {
+      ...readCredentialPolicy(json),
+      requestRetry: { mode: 'custom', value: '0' },
+      touched: { requestRetry: true },
+    },
+  };
+};
+
+describe('native credential policies coexist with fork admission and egress', () => {
+  test('one narrow credential patch updates retry and concurrency without resending secrets or identity', () => {
+    const draft = editor();
+    const before = structuredClone(draft.json);
+    expect(buildAuthFileFieldsPatch(draft, (key) => key)).toEqual({
+      concurrency_limit: 2,
+      request_retry: 0,
+    });
+    expect(draft.json).toEqual(before);
+  });
+  test('configuration-backed concurrency-only edits ignore unrelated policy drafts', () => {
+    const draft = { ...editor(), concurrencyOnly: true, concurrencyLimit: '' };
+    expect(buildAuthFileFieldsPatch(draft, (key) => key)).toEqual({ concurrency_limit: null });
+  });
+  test('Home-managed concurrency remains unchanged while independent policy edits are retained', () => {
+    const draft = { ...editor(), concurrencyManaged: true };
+    expect(buildAuthFileFieldsPatch(draft, (key) => key)).toEqual({ request_retry: 0 });
+  });
+  test.each(['3', ''])('invalid touched policy blocks a combined concurrency %s write', (limit) => {
+    const draft = editor();
+    draft.concurrencyLimit = limit;
+    draft.policy!.requestRetry.value = '-1';
+    expect(() => buildAuthFileFieldsPatch(draft, (key) => key)).toThrow(
+      'auth_files.policy_retry_invalid'
+    );
+  });
+  test('provider policy override and reset retain key limits, proxy, model flags, siblings and unknown metadata', async () => {
+    let stored = {
+      name: 'synthetic-group',
+      'request-retry': 5,
+      'disable-cooling': true,
+      'concurrency-limit': 7,
+      keys: [
+        {
+          'api-key': 'key-a',
+          'proxy-url': 'socks5h://user:synthetic@proxy.invalid:1080',
+          'concurrency-limit': 3,
+          models: [{ name: 'model', 'support-configuration-update': true }],
+          'opaque-field': { enabled: false },
+        },
+        { 'api-key': 'key-b', 'proxy-url': 'direct' },
+      ],
+    };
+    const baseline = structuredClone(stored);
+    apiClient.get = (async () => ({
+      'api-keys': { codex: [structuredClone(stored)] },
+    })) as typeof apiClient.get;
+    apiClient.put = (async (path: string, groups: (typeof stored)[]) => {
+      expect(path).toBe('/config/api-keys/codex');
+      stored = structuredClone(groups[0]);
+    }) as typeof apiClient.put;
+    let selected = normalizeProviderGroups([stored])[0]!;
+    await providersApi.updateCodexConfig(selected.apiKey, selected.baseUrl, {
+      ...selected,
+      ...buildRuntimePolicy({ ...readRuntimePolicy(selected), cooling: 'enabled', retry: '0' }),
+    });
+    expect(stored.keys[0]).toEqual({
+      ...baseline.keys[0],
+      'disable-cooling': false,
+      'request-retry': 0,
+    });
+    expect(stored.keys[1]).toEqual(baseline.keys[1]);
+    expect(stored['concurrency-limit']).toBe(7);
+    selected = normalizeProviderGroups([stored])[0]!;
+    await providersApi.updateCodexConfig(selected.apiKey, selected.baseUrl, {
+      ...selected,
+      ...buildRuntimePolicy({ ...readRuntimePolicy(selected), cooling: 'inherit', retry: '' }),
+    });
+    expect(stored).toEqual(baseline);
+  });
+});
diff --git a/tests/forkV125Contracts.test.ts b/tests/forkV125Contracts.test.ts
new file mode 100644
index 0000000..f0d3b9f
--- /dev/null
+++ b/tests/forkV125Contracts.test.ts
@@ -0,0 +1,72 @@
+import { afterEach, describe, expect, spyOn, test } from 'bun:test';
+import { apiClient } from '@/services/api/client';
+import { codexCredentialIdentityApi } from '@/services/api/codexCredentialIdentity';
+import { logsApi } from '@/services/api/logs';
+import { parseLogLine } from '@/features/logs/model/logParsing';
+
+const restorers: (() => void)[] = [];
+afterEach(() => {
+  for (const restore of restorers.splice(0)) restore();
+});
+
+describe('fork operations on the v8 management API', () => {
+  test('identity status, settings, initialization and rotation use authenticated v8 operations', async () => {
+    const get = spyOn(apiClient, 'get').mockResolvedValue({});
+    const put = spyOn(apiClient, 'put').mockResolvedValue({});
+    const post = spyOn(apiClient, 'post').mockResolvedValue({});
+    restorers.push(
+      () => get.mockRestore(),
+      () => put.mockRestore(),
+      () => post.mockRestore()
+    );
+    await codexCredentialIdentityApi.getStatus();
+    await codexCredentialIdentityApi.update({ credential_proxy_policy: 'require' });
+    await codexCredentialIdentityApi.initialize();
+    await codexCredentialIdentityApi.rotate('synthetic.json', 'synthetic-index');
+    expect(get).toHaveBeenCalledWith('/credentials/codex-identity');
+    expect(put).toHaveBeenCalledWith('/credentials/codex-identity', {
+      credential_proxy_policy: 'require',
+    });
+    expect(post).toHaveBeenCalledWith('/credentials/codex-identity/initialize', {});
+    expect(post).toHaveBeenCalledWith('/credentials/codex-identity/rotate', {
+      name: 'synthetic.json',
+      auth_index: 'synthetic-index',
+      confirm: 'ROTATE',
+    });
+  });
+});
+
+describe('UUID and historical log identifiers', () => {
+  for (const id of ['00000000', 'deadbeef', '019f2222-4444-7777-8abc-0000deadbeef']) {
+    test(`parses and downloads the exact ${id} identifier without truncating`, async () => {
+      const row = parseLogLine(
+        `[2026-09-30 10:00:00] [${id}] [info] [gin.go:20] 200 | 1ms | 127.0.0.1 | POST /v1/responses`
+      );
+      expect(row.requestId).toBe(id);
+      expect(row.level).toBe('info');
+      const get = spyOn(apiClient, 'getRaw').mockResolvedValue({ data: new Blob(['fixture']) });
+      restorers.push(() => get.mockRestore());
+      await logsApi.downloadRequestLogById(id);
+      expect(get.mock.calls[0][0]).toBe(`/observability/logs/requests/${id}`);
+      expect(get.mock.calls[0][1]?.responseType).toBe('blob');
+    });
+  }
+  test('named full UUID remains distinct from an execution UUID in the message', () => {
+    const id = '019f2222-4444-7777-8abc-0000deadbeef';
+    const row = parseLogLine(
+      `[2026-09-30 10:00:00] [info] request_id=${id} | execution_id=9bdf984f-25bb-499e-93b5-796929847c30`
+    );
+    expect(row.requestId).toBe(id);
+  });
+  test('distinct full UUIDs sharing a suffix remain distinct in the UI request', async () => {
+    const get = spyOn(apiClient, 'getRaw').mockResolvedValue({ data: new Blob(['fixture']) });
+    restorers.push(() => get.mockRestore());
+    const ids = ['019f2222-4444-7777-8abc-0000deadbeef', '019f3333-5555-7777-8abc-1111deadbeef'];
+    for (const id of ids) await logsApi.downloadRequestLogById(id);
+    expect(get.mock.calls.map((call) => call[0])).toEqual(
+      ids.map((id) => `/observability/logs/requests/${id}`)
+    );
+    // The backend still resolves filenames by the short suffix. This test only
+    // proves preservation of the supplied UI identifier, not unique file lookup.
+  });
+});
