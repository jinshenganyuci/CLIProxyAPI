--- /dev/null
+++ b/tests/authFileConcurrency.test.ts
@@ -0,0 +1,211 @@
+import { describe, expect, spyOn, test } from 'bun:test';
+import { apiClient } from '../src/services/api/client';
+import { authFilesApi, normalizeAuthFilesResponse } from '../src/services/api/authFiles';
+import {
+  concurrencyIdentity,
+  normalizeAuthFileConcurrency,
+  normalizeConcurrencyEntries,
+  parseConcurrencyLimit,
+} from '../src/services/api/authFileConcurrency';
+import {
+  buildAuthFileFieldsPatch,
+  type PrefixProxyEditorState,
+} from '../src/features/authFiles/hooks/useAuthFilesPrefixProxyEditor';
+
+const editor = (original: Record<string, unknown>, text: string): PrefixProxyEditorState => ({
+  fileName: 'a.json',
+  fileInfoText: '',
+  loading: false,
+  saving: false,
+  error: null,
+  originalText: '',
+  rawText: '',
+  invalidContentPreview: '',
+  json: original,
+  providerKey: 'codex',
+  prefix: '',
+  proxyUrl: '',
+  priority: '',
+  weight: '',
+  weightError: null,
+  concurrencyLimit: text,
+  concurrencyTouched: true,
+  concurrencyError: null,
+  disableCooling: false,
+  disableCoolingTouched: false,
+  websockets: false,
+  websocketsTouched: false,
+  usingApi: false,
+  usingApiTouched: false,
+  note: '',
+  noteTouched: false,
+  excludedModelsText: '',
+  excludedModelsTouched: false,
+  headersText: '',
+  headersTouched: false,
+  headersError: null,
+});
+
+const resolveError = (key: string) => key;
+
+describe('credential concurrency normalization', () => {
+  test('keeps exact occupancy even above a lowered limit', () => {
+    const snapshot = normalizeAuthFileConcurrency({
+      concurrency_limit: 3,
+      concurrency_in_flight: 5,
+    });
+    expect(snapshot).toEqual({ limit: 3, inFlight: 5, managed: false });
+    expect(
+      normalizeAuthFileConcurrency({ concurrency_limit: 10, concurrency_in_flight: 0 })
+    ).toEqual({ limit: 10, inFlight: 0, managed: false });
+  });
+  test('never invents zero or a default for unknown and malformed observations', () => {
+    for (const values of [
+      {},
+      { concurrency_limit: 0, concurrency_in_flight: -1 },
+      { concurrency_limit: '10', concurrency_in_flight: false },
+      { concurrency_limit: 1000001, concurrency_in_flight: 1.2 },
+    ]) {
+      expect(normalizeAuthFileConcurrency(values)).toEqual({
+        limit: null,
+        inFlight: null,
+        managed: false,
+      });
+    }
+  });
+  test('Home management never reports local occupancy or limit', () => {
+    expect(
+      normalizeAuthFileConcurrency({
+        concurrency_managed: true,
+        concurrency_limit: 10,
+        concurrency_in_flight: 0,
+      })
+    ).toEqual({ limit: null, inFlight: null, managed: true });
+  });
+  test('normalizes list and lightweight observations consistently', () => {
+    const entry = {
+      id: 'a',
+      name: 'a.json',
+      auth_index: 'idx-a',
+      concurrency_limit: 10,
+      concurrency_in_flight: 3,
+    };
+    expect(normalizeAuthFilesResponse({ files: [entry] }).files[0].concurrency).toEqual({
+      limit: 10,
+      inFlight: 3,
+      managed: false,
+    });
+    expect(normalizeConcurrencyEntries({ entries: [null, entry] })).toEqual([
+      { id: 'a', name: 'a.json', authIndex: 'idx-a', limit: 10, inFlight: 3, managed: false },
+    ]);
+    for (const invalid of [null, {}, { entries: false }]) {
+      expect(() => normalizeConcurrencyEntries(invalid)).toThrow();
+    }
+  });
+  test('uses stable index identity before filenames, including zero', () => {
+    expect(concurrencyIdentity({ name: 'a.json', authIndex: 'x' })).toBe('index:x');
+    expect(concurrencyIdentity({ name: 'renamed.json', authIndex: 'x' })).toBe('index:x');
+    expect(concurrencyIdentity({ name: 'a.json', authIndex: 0 })).toBe('index:0');
+    expect(concurrencyIdentity({ name: 'a.json', id: 'a' })).toBe('id:a');
+    expect(concurrencyIdentity({ name: 'a.json' })).toBe('name:a.json');
+  });
+});
+
+describe('credential concurrency editor patch', () => {
+  test('sets 3 and restores implicit default 10 through null', () => {
+    expect(buildAuthFileFieldsPatch(editor({}, '3'), resolveError)).toEqual({
+      concurrency_limit: 3,
+    });
+    expect(buildAuthFileFieldsPatch(editor({ concurrency_limit: 3 }, ''), resolveError)).toEqual({
+      concurrency_limit: null,
+    });
+    expect(buildAuthFileFieldsPatch(editor({}, '10'), resolveError)).toEqual({
+      concurrency_limit: 10,
+    });
+  });
+  test('does not change unrelated fields, untouched limits, or Home policy', () => {
+    expect(buildAuthFileFieldsPatch(editor({ concurrency_limit: 3 }, '3'), resolveError)).toEqual(
+      {}
+    );
+    expect(
+      buildAuthFileFieldsPatch({ ...editor({}, '3'), concurrencyTouched: false }, resolveError)
+    ).toEqual({});
+    expect(
+      buildAuthFileFieldsPatch({ ...editor({}, '3'), concurrencyManaged: true }, resolveError)
+    ).toEqual({});
+    expect(buildAuthFileFieldsPatch(editor({}, ''), resolveError)).toEqual({});
+  });
+  test('rejects zero, fractions, negatives, exponent notation and oversized values', () => {
+    for (const value of ['0', '-3', '1.5', 'NaN', '1e3', '1000001', 'Infinity']) {
+      expect(() => parseConcurrencyLimit(value)).toThrow('auth_files.concurrency_invalid');
+      expect(() => buildAuthFileFieldsPatch(editor({}, value), resolveError)).toThrow(
+        'auth_files.concurrency_invalid'
+      );
+    }
+    expect(parseConcurrencyLimit(' 3 ')).toBe(3);
+    expect(parseConcurrencyLimit('1000000')).toBe(1000000);
+    expect(parseConcurrencyLimit(' ')).toBeNull();
+  });
+});
+
+describe('config credential concurrency', () => {
+  test('configuration-only editor emits no unrelated field changes', () => {
+    const state = {
+      ...editor({ concurrency_limit: 10 }, '3'),
+      concurrencyOnly: true,
+      prefix: 'ignored',
+      proxyUrl: 'ignored',
+      headersTouched: true,
+      headersText: 'invalid JSON',
+    };
+    expect(buildAuthFileFieldsPatch(state, resolveError)).toEqual({ concurrency_limit: 3 });
+    expect(
+      normalizeAuthFilesResponse({
+        files: [
+          {
+            name: 'config',
+            runtime_only: true,
+            concurrency_config: true,
+            concurrency_limit: 10,
+            concurrency_in_flight: 0,
+          },
+        ],
+      }).files[0].concurrencyConfig
+    ).toBe(true);
+  });
+  test('uses auth index for exact PATCH identity without changing older callers', async () => {
+    const patch = spyOn(apiClient, 'patch').mockResolvedValue({ status: 'ok' });
+    try {
+      await authFilesApi.patchFields('config', { concurrency_limit: 3 }, 'config-index');
+      expect(patch).toHaveBeenLastCalledWith('/credentials/fields', {
+        name: 'config',
+        auth_index: 'config-index',
+        concurrency_limit: 3,
+      });
+      await authFilesApi.patchFields('credential.json', { concurrency_limit: null });
+      expect(patch).toHaveBeenLastCalledWith('/credentials/fields', {
+        name: 'credential.json',
+        concurrency_limit: null,
+      });
+    } finally {
+      patch.mockRestore();
+    }
+  });
+  test('lightweight polling forwards abort and normalizes only concurrency data', async () => {
+    const controller = new AbortController();
+    const get = spyOn(apiClient, 'get').mockResolvedValue({
+      entries: [
+        { name: 'a.json', auth_index: 'idx-a', concurrency_limit: 3, concurrency_in_flight: 2 },
+      ],
+    });
+    try {
+      const entries = await authFilesApi.concurrency(controller.signal);
+      expect(get).toHaveBeenCalledWith('/credentials/concurrency', { signal: controller.signal });
+      expect(entries).toEqual([
+        { id: '', name: 'a.json', authIndex: 'idx-a', limit: 3, inFlight: 2, managed: false },
+      ]);
+    } finally {
+      get.mockRestore();
+    }
+  });
+});
