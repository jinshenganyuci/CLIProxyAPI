diff --git a/tests/metaOAuth.test.ts b/tests/metaOAuth.test.ts
new file mode 100644
index 0000000..dd663c3
--- /dev/null
+++ b/tests/metaOAuth.test.ts
@@ -0,0 +1,83 @@
+import { afterEach, describe, expect, mock, spyOn, test } from 'bun:test';
+import { createElement } from 'react';
+import { renderToStaticMarkup } from 'react-dom/server';
+import { MemoryRouter } from 'react-router-dom';
+import { I18nextProvider } from 'react-i18next';
+import { createInstance } from 'i18next';
+import { OAuthPage } from '@/pages/OAuthPage';
+import { apiClient } from '@/services/api/client';
+import { oauthApi, type BuiltInOAuthProvider } from '@/services/api/oauth';
+import en from '@/i18n/locales/en.json';
+import zhCN from '@/i18n/locales/zh-CN.json';
+import zhTW from '@/i18n/locales/zh-TW.json';
+import ru from '@/i18n/locales/ru.json';
+
+afterEach(() => mock.restore());
+
+describe('Meta device login', () => {
+  test('normalizes the device response while preserving the selected proxy and attempt signal', async () => {
+    const provider: BuiltInOAuthProvider = 'meta';
+    const signal = new AbortController().signal;
+    const post = spyOn(apiClient, 'post').mockResolvedValue({
+      status: 'ok',
+      flow: 'device',
+      url: 'https://auth.example.invalid/device',
+      state: 'meta-fixture',
+      user_code: ' ABCD-EFGH ',
+      expires_in: 900,
+    });
+    expect(await oauthApi.startAuth(provider, signal, { proxyURL: 'direct' })).toEqual({
+      status: 'ok',
+      flow: 'device',
+      url: 'https://auth.example.invalid/device',
+      state: 'meta-fixture',
+      userCode: 'ABCD-EFGH',
+      expiresIn: 900,
+    });
+    expect(post).toHaveBeenCalledWith(
+      '/meta-auth-url',
+      {
+        is_webui: true,
+        proxy_url: 'direct',
+      },
+      { signal }
+    );
+  });
+
+  for (const value of [undefined, null, '', '900', -1, 0, Infinity, NaN, {}]) {
+    test(`does not invent an expiry from an invalid response (${String(value)})`, async () => {
+      spyOn(apiClient, 'post').mockResolvedValue({
+        url: 'https://auth.example.invalid/device',
+        state: 'meta-fixture',
+        user_code: {},
+        expires_in: value,
+      });
+      const response = await oauthApi.startAuth('meta');
+      expect(response.expiresIn).toBeUndefined();
+      expect(response.userCode).toBeUndefined();
+    });
+  }
+
+  test('renders the device login card and preserves native and fork login controls in every locale', async () => {
+    const keys = Object.keys(en.auth_login).filter((key) => key.startsWith('meta_'));
+    expect(keys.length).toBeGreaterThanOrEqual(25);
+    for (const [language, locale] of Object.entries({ en, 'zh-CN': zhCN, 'zh-TW': zhTW, ru })) {
+      const i18n = createInstance();
+      await i18n.init({ lng: language, resources: { [language]: { translation: locale } } });
+      const markup = renderToStaticMarkup(
+        createElement(
+          I18nextProvider,
+          { i18n },
+          createElement(MemoryRouter, null, createElement(OAuthPage))
+        )
+      );
+      expect(markup).toContain(locale.auth_login.meta_oauth_title);
+      expect(markup).toContain('meta-oauth-proxy-mode');
+      expect(markup).toContain('codex-oauth-proxy-mode');
+      expect(markup).toContain('devin-oauth-proxy-mode');
+      expect(markup).not.toContain('auth_login.meta_');
+      for (const key of keys)
+        expect((locale.auth_login as Record<string, string>)[key]?.trim()).toBeTruthy();
+    }
+  });
+});
diff --git a/tests/oauthProxyApi.test.ts b/tests/oauthProxyApi.test.ts
new file mode 100644
index 0000000..eb0e91d
--- /dev/null
+++ b/tests/oauthProxyApi.test.ts
@@ -0,0 +1,76 @@
+import { afterEach, describe, expect, mock, spyOn, test } from 'bun:test';
+import { apiClient } from '@/services/api/client';
+import { oauthApi } from '@/services/api/oauth';
+
+const started = { url: 'https://auth.example.invalid/authorize', state: 'synthetic-state' };
+
+afterEach(() => mock.restore());
+
+for (const provider of ['codex', 'devin', 'meta']) {
+  describe(`${provider} login proxy requests`, () => {
+    test('sends proxy credentials only in the POST body and preserves cancellation', async () => {
+      const post = spyOn(apiClient, 'post').mockResolvedValue(started);
+      const get = spyOn(apiClient, 'get').mockResolvedValue(started);
+      const proxyURL = 'http://test-user:test-password@proxy.example.invalid:8080';
+      const signal = new AbortController().signal;
+
+      await oauthApi.startAuth(provider, signal, { proxyURL: ` ${proxyURL} ` });
+
+      expect(post).toHaveBeenCalledWith(
+        `/${provider}-auth-url`,
+        {
+          is_webui: true,
+          proxy_url: proxyURL,
+        },
+        { signal }
+      );
+      expect(get).not.toHaveBeenCalled();
+    });
+
+    test('distinguishes global settings from explicit direct access', async () => {
+      const post = spyOn(apiClient, 'post').mockResolvedValue(started);
+
+      await oauthApi.startAuth(provider);
+      await oauthApi.startAuth(provider, undefined, { proxyURL: 'direct' });
+
+      expect(post.mock.calls).toEqual([
+        [`/${provider}-auth-url`, { is_webui: true }, undefined],
+        [`/${provider}-auth-url`, { is_webui: true, proxy_url: 'direct' }, undefined],
+      ]);
+    });
+  });
+}
+
+test('retains a Codex reauthentication target without putting it in the URL', async () => {
+  const post = spyOn(apiClient, 'post').mockResolvedValue(started);
+
+  await oauthApi.startAuth('codex', undefined, {
+    authIndex: 'synthetic-index',
+    proxyURL: 'direct',
+  });
+
+  expect(post).toHaveBeenCalledWith(
+    '/codex-auth-url',
+    {
+      is_webui: true,
+      proxy_url: 'direct',
+      auth_index: 'synthetic-index',
+    },
+    undefined
+  );
+});
+
+test('leaves other provider login requests unchanged', async () => {
+  const get = spyOn(apiClient, 'get').mockResolvedValue(started);
+  const post = spyOn(apiClient, 'post').mockResolvedValue(started);
+  const signal = new AbortController().signal;
+
+  await oauthApi.startAuth('anthropic', signal, { proxyURL: 'direct' });
+  await oauthApi.startAuth('kimi');
+
+  expect(get.mock.calls).toEqual([
+    ['/anthropic-auth-url', { params: { is_webui: true }, signal }],
+    ['/kimi-auth-url', { params: undefined }],
+  ]);
+  expect(post).not.toHaveBeenCalled();
+});
