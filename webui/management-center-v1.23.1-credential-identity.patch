diff --git a/src/services/api/codexCredentialIdentity.ts b/src/services/api/codexCredentialIdentity.ts
new file mode 100644
index 0000000..574405e
--- /dev/null
+++ b/src/services/api/codexCredentialIdentity.ts
@@ -0,0 +1,71 @@
+import { apiClient } from './client';
+
+export type CodexCredentialIdentityStatusName = 'ready' | 'missing' | 'invalid' | 'conflict';
+
+export type CodexCredentialIdentityProxyMode = 'proxy' | 'direct' | 'inherit' | 'invalid';
+
+export type CodexCredentialIdentityCredential = {
+  name: string;
+  auth_index?: string;
+  email?: string;
+  status: CodexCredentialIdentityStatusName;
+  identity_hash?: string;
+  proxy_mode: CodexCredentialIdentityProxyMode;
+  source_backend?: string;
+  writable: boolean;
+  message?: string;
+};
+
+export type CodexCredentialIdentityStatus = {
+  enabled: boolean;
+  synthesize_missing_installation_id: boolean;
+  credential_proxy_policy: 'prefer' | 'require';
+  legacy_identity_confuse: boolean;
+  total: number;
+  ready: number;
+  missing: number;
+  invalid: number;
+  conflicts: number;
+  unsupported: number;
+  proxy_missing: number;
+  all_ready: boolean;
+  credentials: CodexCredentialIdentityCredential[];
+};
+
+export type UpdateCodexCredentialIdentityRequest = {
+  enabled?: boolean;
+  synthesize_missing_installation_id?: boolean;
+  credential_proxy_policy?: 'prefer' | 'require';
+};
+
+export const codexCredentialIdentityApi = {
+  getStatus: () => apiClient.get<CodexCredentialIdentityStatus>('/codex-credential-identity'),
+
+  update: (request: UpdateCodexCredentialIdentityRequest) =>
+    apiClient.put<{
+      status: string;
+      enabled: boolean;
+      synthesize_missing_installation_id: boolean;
+      credential_proxy_policy: 'prefer' | 'require';
+    }>('/codex-credential-identity', request),
+
+  initialize: () =>
+    apiClient.post<{
+      status: string;
+      initialized: number;
+      identity: CodexCredentialIdentityStatus;
+    }>('/codex-credential-identity/initialize', {}),
+
+  rotate: (name: string, authIndex?: string) =>
+    apiClient.post<{
+      status: string;
+      name: string;
+      auth_index?: string;
+      identity_hash: string;
+      sessions_reset: boolean;
+    }>('/codex-credential-identity/rotate', {
+      name,
+      auth_index: authIndex || undefined,
+      confirm: 'ROTATE',
+    }),
+};
